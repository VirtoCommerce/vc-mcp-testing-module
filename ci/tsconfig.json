{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": ["*.ts", "lib/*.ts", "../scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
