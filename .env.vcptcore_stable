# ==============================================================================
# vcptcore-stable environment — dedicated latest-STABLE instance (hotfix landing zone).
# Store B2B-store, catalog B2B-mixed (fc596540…), en-US/USD, mainFFC 142ba55…. admin/Password1.
# Activate: TEST_ENV=vcptcore_stable npm run env:check
# Committed; URLs/identifiers only — secrets live in .env.local.
#
# Per-env secret overrides: add *_VCPTCORE_STABLE vars to .env.local;
# config.js promotes them over the generic ADMIN_PASSWORD/ORG_USER_PASSWORD/etc.
# NOTE: admin password here is `Password1` (NOT `Password1!` like qa1).
# ==============================================================================

# --- Risk gate ---------------------------------------------------------------
# QA env — admin-write suites + seeders allowed (not production).
ENV_RISK=test

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-stable-storefront.govirto.com
BACK_URL=https://vcptcore-stable.govirto.com
STORYBOOK_URL=https://vcptcore-stable-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcptcore-stable-storybook.govirto.com

# --- Deploy manifest (hotfix delivery target — read by /qa-hotfix-check) ------
# This env is provisioned from vc-deploy-dev @ this branch's backend/packages.json.
# `scripts/hotfix-deliver.ts` bumps a module/Platform version here (commit
# "VCST-XXXX: <title>"), then waits for the deploy Action + polls /api/platform/modules.
DEPLOY_REPO=VirtoCommerce/vc-deploy-dev
DEPLOY_BRANCH=vcptcore-stable
DEPLOY_PACKAGES_PATH=backend/packages.json
DEPLOY_PACKAGES_URL=https://github.com/VirtoCommerce/vc-deploy-dev/blob/vcptcore-stable/backend/packages.json

