<mxfile host="app.diagrams.net" agent="scripts/docs/gen-kb-v3-diagrams.mjs" version="24.0.0">
  <diagram id="Процесс целиком" name="Процесс целиком">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1110" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="База знаний v3 — процесс целиком" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="Внутрь ведут ровно два пути: детерминированное извлечение и фиксация с доказательством. База стартует пустой; всё остальное — петли, которые удерживают её правильной." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="54" width="1260" height="34" as="geometry" />
        </mxCell>
        <mxCell id="LS" value="Источники истины — вне базы. База никогда не ссылается на себя как на доказательство" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9db3ad;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="1300" height="96" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="vc-platform · vc-module-*&lt;br&gt;vc-frontend · репозитории клиента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f4;strokeColor=#7d8d87;fontColor=#3f4d49;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="132" width="260" height="52" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="Живой деплоймент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f4;strokeColor=#7d8d87;fontColor=#3f4d49;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="356" y="132" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="Официальная&lt;br&gt;документация" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f4;strokeColor=#7d8d87;fontColor=#3f4d49;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="552" y="132" width="180" height="52" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="ADR · обсуждения PR&lt;br&gt;решения в трекере" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f4;strokeColor=#7d8d87;fontColor=#3f4d49;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="748" y="132" width="280" height="52" as="geometry" />
        </mxCell>
        <mxCell id="S5" value="Наблюдаемая практика&lt;br&gt;(как команда делает на самом деле)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f4;strokeColor=#7d8d87;fontColor=#3f4d49;dashed=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1044" y="132" width="296" height="52" as="geometry" />
        </mxCell>
        <mxCell id="LD" value="Выводимый слой — регенерируется, статусов не имеет, протухнуть не может" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5fa79c;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#0b4d45;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="216" width="640" height="232" as="geometry" />
        </mxCell>
        <mxCell id="EXT" value="&lt;b&gt;Экстракторы&lt;/b&gt;&lt;br&gt;манифесты · REST · GraphQL SDL&lt;br&gt;настройки · права · маршруты витрины&lt;br&gt;детерминированно, без LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="252" width="280" height="84" as="geometry" />
        </mxCell>
        <mxCell id="TBL" value="&lt;b&gt;derived/&lt;/b&gt;&lt;br&gt;сгенерированные таблицы&lt;br&gt;+ агрегатные записи на них" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#eef2f1;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="384" y="252" width="296" height="84" as="geometry" />
        </mxCell>
        <mxCell id="DIF" value="&lt;b&gt;Дифф регенерации = поток событий&lt;/b&gt;&lt;br&gt;серьёзность: breaking · dangerous · safe&lt;br&gt;--check сверяет побайтно: слой не может молча отстать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="356" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="LA" value="Агент в работе — единственное место, где есть модель и живая среда" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#cf9a6a;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#7a3f16;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="720" y="216" width="640" height="232" as="geometry" />
        </mxCell>
        <mxCell id="ASK" value="&lt;b&gt;1 · Спросить базу&lt;/b&gt;&lt;br&gt;как читатель, своими словами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0e6;strokeColor=#a85a22;fontColor=#7a3f16;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="252" width="180" height="84" as="geometry" />
        </mxCell>
        <mxCell id="NOV" value="&lt;b&gt;2 · Протокол новизны&lt;/b&gt;&lt;br&gt;канонизация → отпечаток&lt;br&gt;→ почти-дубликаты 0.90 / 0.70" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0e6;strokeColor=#a85a22;fontColor=#7a3f16;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="940" y="252" width="200" height="84" as="geometry" />
        </mxCell>
        <mxCell id="CAP" value="&lt;b&gt;3 · kb capture&lt;/b&gt;&lt;br&gt;доказательство и refutableBy&lt;br&gt;обязательны, иначе отказ&lt;br&gt;оси: docs · live · source&lt;br&gt;артефакт · практика" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0e6;strokeColor=#a85a22;fontColor=#7a3f16;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1160" y="252" width="180" height="84" as="geometry" />
        </mxCell>
        <mxCell id="OUT" value="&lt;b&gt;Четыре исхода, и только один создаёт запись&lt;/b&gt;&lt;br&gt;дубль → подтверждение · другой аспект → черновик + связь&lt;br&gt;противоречие → спор · ничего → честно новый черновик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0e6;strokeColor=#a85a22;fontColor=#7a3f16;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="356" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="RCK" value="&lt;b&gt;Перепроверку инициирует система&lt;/b&gt;&lt;br&gt;события дрейфа · ротация в CI · пометка на чтении&lt;br&gt;очередь: due → цитируемость → давность → задание туда, где есть среда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="476" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="DRF" value="&lt;b&gt;drafts/&lt;/b&gt; — только дописывание, дедуп по отпечатку, тумбстоуны финальны" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#eef2f1;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="476" width="600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="CONS" value="&lt;b&gt;Консолидация — CI внутри репозитория базы: детерминированный Node, ноль зависимостей, без LLM, без сети&lt;/b&gt;&lt;br&gt;&lt;br&gt;планка доказательств и пол плоскости · взвешенный счёт доверия · карантин аномального пакета · защита слоя&lt;br&gt;бюджет продвижений на прогон · гейт экзамена до/после · один batch-коммит со сводкой&lt;br&gt;&lt;br&gt;что делает каждый провал — страница «Гейты консолидации»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="1300" height="104" as="geometry" />
        </mxCell>
        <mxCell id="REV" value="Регресс поиска → авто-откат батча, черновики возвращаются целыми.&lt;br&gt;Два отката подряд — громкая эскалация, а не бесконечный повтор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7e6ea;strokeColor=#8e2b3e;fontColor=#6b1f2e;fontSize=12;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="716" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ENT" value="&lt;b&gt;entries/&lt;/b&gt; — KB-* (платформа) · KB-C-* (клиент)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#eef2f1;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="716" width="620" height="56" as="geometry" />
        </mxCell>
        <mxCell id="IDX" value="knowledge-index.json + catalog.md — генерируются, гейт дрейфа" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="796" width="620" height="56" as="geometry" />
        </mxCell>
        <mxCell id="LR" value="Выдача — единственная дверь; поиск детерминированный, без обучаемых частей" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9db3ad;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="1300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="RES" value="&lt;b&gt;Резолвер&lt;/b&gt;&lt;br&gt;@kb(id) · тема&lt;br&gt;клиентская дельта аннотирует,&lt;br&gt;а не прячет платформенную" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="916" width="230" height="96" as="geometry" />
        </mxCell>
        <mxCell id="ANS" value="&lt;b&gt;Контракт ответа&lt;/b&gt;&lt;br&gt;id · доверие · свежесть · провенанс · спорность&lt;br&gt;зацепки — отдельной секцией, не фактами&lt;br&gt;нет ответа → явный MISS, а не пустота" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="334" y="916" width="400" height="96" as="geometry" />
        </mxCell>
        <mxCell id="AGT" value="&lt;b&gt;Агент-потребитель&lt;/b&gt;&lt;br&gt;цитирует @kb(id)&lt;br&gt;проверка ∝ цене ошибки&lt;br&gt;доносит провенанс,&lt;br&gt;свежесть и спорность" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0e6;strokeColor=#a85a22;fontColor=#7a3f16;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="758" y="916" width="170" height="96" as="geometry" />
        </mxCell>
        <mxCell id="HUM" value="&lt;b&gt;Человек&lt;/b&gt;&lt;br&gt;только через агента" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f7e6ea;strokeColor=#8e2b3e;fontColor=#6b1f2e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="952" y="916" width="150" height="96" as="geometry" />
        </mxCell>
        <mxCell id="VET" value="&lt;b&gt;Инструменты вето&lt;/b&gt;&lt;br&gt;retire · pin · dispute&lt;br&gt;+ читаемая сводка&lt;br&gt;машина обязана подчиниться" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f7e6ea;strokeColor=#8e2b3e;fontColor=#6b1f2e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1126" y="916" width="214" height="96" as="geometry" />
        </mxCell>
        <mxCell id="LEG" value="Бирюзовый — детерминированный путь (работает офлайн, без модели) · оранжевый — путь, где нужна модель и живая среда · бордовый пунктир — понижение доверия и откат · серый пунктир — обратная связь" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfaf7;strokeColor=#c8cfcc;fontColor=#4b5c57;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
