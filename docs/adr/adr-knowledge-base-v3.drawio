        </mxCell>
        <mxCell id="C6" value="Заводится и бутстрапится в /project-init: найти по маркеру или создать с нуля" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="366" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="SYNC" value="&lt;b&gt;SessionStart sync&lt;/b&gt;&lt;br&gt;fail-open, ≤2 с" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="CACHE" value="&lt;b&gt;Локальный кэш платформенной базы&lt;/b&gt;&lt;br&gt;readOnly: true, закреплён на коммите" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="360" height="64" as="geometry" />
        </mxCell>
        <mxCell id="RES" value="&lt;b&gt;Один резолвер над обоими корнями&lt;/b&gt;&lt;br&gt;приоритет + группировка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="480" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ANS" value="&lt;b&gt;Ответ: платформенная запись&lt;/b&gt;&lt;br&gt;+ блок клиентской дельты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="480" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="VIS" value="Подавленное правило приглушается в ранжировании, но из выдачи не исчезает никогда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="566" width="620" height="44" as="geometry" />
        </mxCell>
        <mxCell id="LU" value="Промоушен: клиент → платформа. Единственный путь наверх, и он никогда не срабатывает сам" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9db3ad;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="1300" height="300" as="geometry" />
        </mxCell>
        <mxCell id="U1" value="&lt;b&gt;Запись помечена promotable&lt;/b&gt;&lt;br&gt;«верно и на чистой платформе&lt;br&gt;версии клиента»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0e6;strokeColor=#a85a22;fontColor=#7a3f16;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="U2" value="&lt;b&gt;Линт на стороне клиента&lt;/b&gt;&lt;br&gt;идентификаторы клиента в тексте&lt;br&gt;или ссылках → отказ до отправки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7e6ea;strokeColor=#8e2b3e;fontColor=#6b1f2e;fontSize=12;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="390" y="680" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="U3" value="&lt;b&gt;GitHub issue строгой формы&lt;/b&gt;&lt;br&gt;закрытые словари, ноль свободных полей&lt;br&gt;о клиенте не сообщается ничего" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a55;fontColor=#16211e;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="680" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="U4" value="&lt;b&gt;kb ingest-issues в CI платформы&lt;/b&gt;&lt;br&gt;валидация схемы → drafts/&lt;br&gt;никогда не сразу в entries/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1020" y="680" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="U5" value="Дальше — обычный жизненный цикл. Подтвердить такую запись можно только&lt;br&gt;платформенными доказательствами: клиентская проза не становится знанием&lt;br&gt;платформы по собственному праву" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f1ee;strokeColor=#0f6f63;fontColor=#0b4d45;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="390" y="800" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="U6" value="Форма не распознана → метка kb-invalid,&lt;br&gt;не парсится: молчаливого приёма мусора нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7e6ea;strokeColor=#8e2b3e;fontColor=#6b1f2e;fontSize=12;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1020" y="800" width="320" height="76" as="geometry" />
        </mxCell>
        <mxCell id="N" value="Изоляция обеспечена типом, а не аккуратностью: платформенный кэш объявляет readOnly, запись scope:client в платформенном корне отклоняется как ошибка контейнмента, а клиентский корень физически не может чеканить платформенный id.&lt;br&gt;Ошибка маршрутизации трактуется как клиентская запись и останавливает работу: при сомнении содержимое остаётся у клиента." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfaf7;strokeColor=#c8cfcc;fontColor=#4b5c57;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
