        <mxCell id="C5" value="Дельты: override · extend · suppress&lt;br&gt;+ машинный пин {hash, commit} на платформенную запись" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf0e6;strokeColor=#a85a22;fontColor=#7a3f16;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
