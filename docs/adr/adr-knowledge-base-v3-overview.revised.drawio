                <mxCell id="HUM" value="Person&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;manager · developer&lt;br&gt;tester · analyst&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=68;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="260" width="270" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="HUM-b" value="•&amp;nbsp; gives the agent a task&lt;br&gt;•&amp;nbsp; asks the agent a question&lt;br&gt;•&amp;nbsp; gets the agent's answer — with a warning when trust is partial" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" parent="HUM" vertex="1">
                    <mxGeometry y="68" width="270" height="107" as="geometry"/>
                </mxCell>
                <mxCell id="AGT" value="The assistant agent" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="380" y="240" width="380" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="AGT-b" value="•&amp;nbsp; does the work: fixes, tests, explains&lt;br&gt;•&amp;nbsp; asks the reference desk before starting&lt;br&gt;•&amp;nbsp; looks at the product itself: code, the live environment, documents&lt;br&gt;•&amp;nbsp; hands what is new to the reference desk — with evidence&lt;br&gt;•&amp;nbsp; confirms the records it relied on&lt;br&gt;•&amp;nbsp; disputes a record that contradicts the product&lt;br&gt;•&amp;nbsp; tells the person where the answer came from" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="AGT" vertex="1">
                    <mxGeometry y="36" width="380" height="154" as="geometry"/>
                </mxCell>
                <mxCell id="WIN" value="Knowledge Resolver&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Unified Knowledge Access &amp; Routing Gateway&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="380" y="470" width="380" height="246" as="geometry"/>
                </mxCell>
                <mxCell id="WIN-b" value="•&amp;nbsp; takes both questions and new knowledge from the agent&lt;br&gt;•&amp;nbsp; assembles the answer from the bases that exist&lt;br&gt;•&amp;nbsp; before writing, it checks for itself whether this already exists&lt;br&gt;•&amp;nbsp; writes into its project’s base and no other&lt;br&gt;•&amp;nbsp; gives one current state — a superseded record never enters an answer&lt;br&gt;•&amp;nbsp; shows both sides when a project overrides the platform, or a record is disputed&lt;br&gt;•&amp;nbsp; tells the agent how far to trust the answer&lt;br&gt;•&amp;nbsp; says &quot;don't know&quot; when there is no answer, and offers leads separately — marked as not facts" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="WIN" vertex="1">
                    <mxGeometry y="52" width="380" height="194" as="geometry"/>
                </mxCell>
                <mxCell id="OPT" value="Only a client project has this" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="860" y="485" width="790" height="305" as="geometry"/>
                </mxCell>
                <mxCell id="KBP" value="The platform knowledge base&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;true for any project&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="880" y="240" width="360" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="KBP-b" value="•&amp;nbsp; takes drafts through the reference desk&lt;br&gt;•&amp;nbsp; gives the engine its drafts and the records due for a re-check&lt;br&gt;•&amp;nbsp; gives its records to the reference desk&lt;br&gt;•&amp;nbsp; gives its records to project bases&lt;br&gt;•&amp;nbsp; takes proposals from projects as drafts&lt;br&gt;•&amp;nbsp; verifies a proposal with its own evidence before accepting it" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" parent="KBP" vertex="1">
                    <mxGeometry y="52" width="360" height="153" as="geometry"/>
                </mxCell>
                <mxCell id="KBC" value="Project knowledge base&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the truth about this project&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="880" y="505" width="360" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="KBC-b" value="•&amp;nbsp; takes drafts through the reference desk&lt;br&gt;•&amp;nbsp; gives the engine its drafts and the records due for a re-check&lt;br&gt;•&amp;nbsp; gives its records to the reference desk&lt;br&gt;•&amp;nbsp; reads the platform's records&lt;br&gt;•&amp;nbsp; overrides platform rules locally&lt;br&gt;•&amp;nbsp; cancels platform rules that do not apply here&lt;br&gt;•&amp;nbsp; extends platform rules with its own&lt;br&gt;•&amp;nbsp; raises a dispute when an overridden rule changes&lt;br&gt;•&amp;nbsp; never writes to the platform base&lt;br&gt;•&amp;nbsp; strips every trace of the project before sending upward&lt;br&gt;•&amp;nbsp; sends upward, as a draft, what holds without customization" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" parent="KBC" vertex="1">
                    <mxGeometry y="52" width="360" height="208" as="geometry"/>
                </mxCell>
                <mxCell id="KEEP" value="Consolidation &amp; Verification Engine&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Deterministic Knowledge Lifecycle &amp; Verification Engine&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="380" y="756" width="380" height="348" as="geometry"/>
                </mxCell>
                <mxCell id="KEEP-b" value="•&amp;nbsp; takes the drafts out of the base and works through them&lt;br&gt;•&amp;nbsp; refuses a draft with no evidence, or with no way to refute it&lt;br&gt;•&amp;nbsp; counts a repeat of the same fact as confirmation, not a new record&lt;br&gt;•&amp;nbsp; raises a record to full trust on its own, without a human&lt;br&gt;•&amp;nbsp; reads the sources: rechecks at once on a change, the rest in turn&lt;br&gt;•&amp;nbsp; marks a superseded record and drops it from answers, keeps the history&lt;br&gt;•&amp;nbsp; raises a dispute on contradicting records and settles it by checking&lt;br&gt;•&amp;nbsp; never touches what the operator pinned, never restores what they retired&lt;br&gt;•&amp;nbsp; writes only to its own base — never from a project into the platform base&lt;br&gt;•&amp;nbsp; runs outside sessions: on changes and on a schedule&lt;br&gt;•&amp;nbsp; publishes the change digest to the operator" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="KEEP" vertex="1">
                    <mxGeometry y="52" width="380" height="268" as="geometry"/>
                </mxCell>
                <mxCell id="OPP" value="Platform operator&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Virto employee&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1320" y="230" width="310" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="OPP-b" value="•&amp;nbsp; retires a wrong record — the trace remains&lt;br&gt;•&amp;nbsp; pins a record — the engine will not edit or retire it&lt;br&gt;•&amp;nbsp; puts a record in doubt: the engine rechecks it&lt;br&gt;•&amp;nbsp; sets the engine's rules for raising trust&lt;br&gt;•&amp;nbsp; reads the change digest — optional&lt;br&gt;•&amp;nbsp; steps into what is already settled: no work waits for them" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" parent="OPP" vertex="1">
                    <mxGeometry y="52" width="310" height="183" as="geometry"/>
                </mxCell>
                <mxCell id="OPC" value="Project operator&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;client employee&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1320" y="505" width="310" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="OPC-b" value="•&amp;nbsp; retires a wrong record — the trace remains&lt;br&gt;•&amp;nbsp; pins a record — the engine will not edit or retire it&lt;br&gt;•&amp;nbsp; puts a record in doubt: the engine rechecks it&lt;br&gt;•&amp;nbsp; sets the engine's rules for raising trust&lt;br&gt;•&amp;nbsp; reads the change digest — optional&lt;br&gt;•&amp;nbsp; steps into what is already settled: no work waits for them" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" parent="OPC" vertex="1">
                    <mxGeometry y="52" width="310" height="183" as="geometry"/>
                </mxCell>
                <mxCell id="SRC" value="Sources&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;code · environment · documentation · team decisions&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="566" width="275" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="SRC-b" value="•&amp;nbsp; hold the actual state of the product&lt;br&gt;•&amp;nbsp; give the material for the first fill of an empty base&lt;br&gt;•&amp;nbsp; give evidence to the agent and to the engine alike" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="SRC" vertex="1">
                    <mxGeometry y="52" width="300" height="98" as="geometry"/>
