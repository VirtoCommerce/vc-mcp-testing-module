    </diagram>
    <diagram id="The assistant agent" name="The assistant agent">
        <mxGraphModel dx="1658" dy="770" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1020" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="The assistant agent — who fills the base, and on what terms" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="24" width="1300" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="ts" value="The only party that sees the live product, and therefore the only source of new knowledge. It does not write down everything: only what will serve someone else, only with evidence, and only once it has named what could refute it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="62" width="1340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="IN1" value="From the person&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;a task or a question&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="210" width="340" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="IN1-b" value="•&amp;nbsp; what needs doing&lt;br&gt;•&amp;nbsp; a question that needs an answer" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN1" vertex="1">
                    <mxGeometry y="52" width="340" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="IN2" value="From the reference desk&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;on every request&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="380" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="IN2-b" value="•&amp;nbsp; the answer and where it came from&lt;br&gt;•&amp;nbsp; how far to trust it&lt;br&gt;•&amp;nbsp; leads, when there is no answer&lt;br&gt;•&amp;nbsp; a request to re-check what you are relying on" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN2" vertex="1">
                    <mxGeometry y="52" width="340" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="IN3" value="The product&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;what can be seen first-hand&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="600" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="IN3-b" value="•&amp;nbsp; code and schemas&lt;br&gt;•&amp;nbsp; the live environment: open it, click, measure&lt;br&gt;•&amp;nbsp; documents and team decisions" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN3" vertex="1">
                    <mxGeometry y="52" width="340" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="BOX" value="Doing the work and observing it are one activity" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="440" y="190" width="610" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="A" value="Asks before working&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;cheaper than working it out again&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="220" width="560" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="A-b" value="•&amp;nbsp; asks in its own words, not by record number&lt;br&gt;•&amp;nbsp; high trust — it takes the answer and gets on&lt;br&gt;•&amp;nbsp; partial — it verifies for itself before leaning on it" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="A" vertex="1">
                    <mxGeometry y="52" width="560" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="B" value="Does the task and cross-checks&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;along the way, not as a separate step&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="400" width="560" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="B-b" value="•&amp;nbsp; fixes, tests, explains&lt;br&gt;•&amp;nbsp; checks what the base says against what the product shows&lt;br&gt;•&amp;nbsp; a discrepancy is a finding, not an obstacle" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="B" vertex="1">
                    <mxGeometry y="52" width="560" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="C" value="Writes down what is new&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;only what will serve someone else&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="580" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="C-b" value="•&amp;nbsp; with evidence: what was seen, where, and what backs it&lt;br&gt;•&amp;nbsp; names what could refute it — otherwise it is not accepted&lt;br&gt;•&amp;nbsp; a defect with a ticket is not written down: the tracker owns it" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="C" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="D" value="Confirms and disputes&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the cheapest part, and the most useful&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="770" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="D-b" value="•&amp;nbsp; relied on a record and it held — it confirms the record&lt;br&gt;•&amp;nbsp; it diverged from the product — it disputes, with evidence&lt;br&gt;•&amp;nbsp; saw the same thing again — that is a confirmation, not a new record" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="D" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1" value="To the person&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the result of the work&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="400" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1-b" value="•&amp;nbsp; what was done&lt;br&gt;•&amp;nbsp; what it leaned on, and how far to trust that" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT1" vertex="1">
                    <mxGeometry y="52" width="330" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="OUT2" value="To the reference desk&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;through the single door&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="700" width="330" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="OUT2-b" value="•&amp;nbsp; new knowledge — as a draft&lt;br&gt;•&amp;nbsp; a confirmation of a record&lt;br&gt;•&amp;nbsp; a dispute with a record" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT2" vertex="1">
                    <mxGeometry y="52" width="330" height="138" as="geometry"/>
                </mxCell>
                <mxCell id="Age1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.393;entryDx=0;entryDy=0;" parent="1" source="IN1" target="A" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Age2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.571;entryDx=0;entryDy=0;" parent="1" source="IN2" target="A" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="435" y="465"/>
                            <mxPoint x="435" y="300"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="Age3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="IN3" target="B" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="420" y="675"/>
                            <mxPoint x="420" y="470"/>
