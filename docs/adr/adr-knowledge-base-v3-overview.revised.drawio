    <diagram id="The operator" name="The operator">
        <mxGraphModel dx="1658" dy="770" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1010" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="The operator — four instruments, and how to use them" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="24" width="1300" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="ts" value="A person approves no knowledge and works no queue — they step into what has already been settled. Each instrument forbids the machine something, and that prohibition is the one thing the machine cannot lift by itself." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="62" width="1340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="IN1" value="The digest from the engine&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;after every run&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="220" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="IN1-b" value="•&amp;nbsp; what was applied and what was superseded&lt;br&gt;•&amp;nbsp; what got reverted&lt;br&gt;•&amp;nbsp; how many records changed label&lt;br&gt;•&amp;nbsp; reading is optional" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN1" vertex="1">
                    <mxGeometry y="52" width="340" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="IN2" value="A complaint from a person&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;rarely&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="440" width="340" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="IN2-b" value="•&amp;nbsp; the agent answered nonsense&lt;br&gt;•&amp;nbsp; the rule no longer holds&lt;br&gt;•&amp;nbsp; this went stale long ago" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN2" vertex="1">
                    <mxGeometry y="52" width="340" height="103" as="geometry"/>
                </mxCell>
                <mxCell id="BOX" value="Four instruments, and nothing else" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="440" y="190" width="620" height="760" as="geometry"/>
                </mxCell>
                <mxCell id="A" value="Retire a record&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;when it is wrong and will not become right&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="230" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="A-b" value="•&amp;nbsp; takes it out of answers&lt;br&gt;•&amp;nbsp; the trace stays: it is visible that it existed, and who retired it&lt;br&gt;•&amp;nbsp; the machine will never bring it back on its own" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" parent="A" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="B" value="Pin a record&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;when a rule matters more than the statistics&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="410" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="B-b" value="•&amp;nbsp; the machine may not edit, demote, supersede or retire it&lt;br&gt;•&amp;nbsp; confirmations and disputes still accumulate against it — the digest shows them" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" parent="B" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="C" value="Put a record in doubt&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;when there is suspicion but no evidence&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="590" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="C-b" value="•&amp;nbsp; trust drops to none on both sides&lt;br&gt;•&amp;nbsp; the engine re-checks from scratch&lt;br&gt;•&amp;nbsp; only a fresh check can lift the doubt — never an opinion" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" parent="C" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="D" value="Set the thresholds&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;when things clear the bar too easily, or never&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="770" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="D-b" value="•&amp;nbsp; changes what evidence it takes for the machine to raise trust&lt;br&gt;•&amp;nbsp; applies to every record at once&lt;br&gt;•&amp;nbsp; the digest reports how many records changed label" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" parent="D" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1" value="Into its own base&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;its own base only&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="250" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1-b" value="•&amp;nbsp; the marks: retired, pinned, in doubt&lt;br&gt;•&amp;nbsp; the new trust thresholds&lt;br&gt;•&amp;nbsp; never touches another base" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT1" vertex="1">
                    <mxGeometry y="52" width="340" height="138" as="geometry"/>
                </mxCell>
                <mxCell id="NOTE" value="&lt;b&gt;How to use them&lt;/b&gt;&lt;br&gt;&lt;br&gt;•&amp;nbsp; read the digest if you feel like it — no work waits on it&lt;br&gt;•&amp;nbsp; step in on a complaint or your own suspicion, never on a schedule&lt;br&gt;•&amp;nbsp; do not check everything: that is the engine’s job&lt;br&gt;•&amp;nbsp; doubt is cheaper than retirement — prefer it when unsure&lt;br&gt;•&amp;nbsp; pinning is rare: it switches the machine off for that record" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fbfaf7;strokeColor=#c8cfcc;fontColor=#4b5c57;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=12;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1120" y="500" width="340" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="Ope1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.151;entryDx=0;entryDy=0;" parent="1" source="IN1" target="BOX" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Ope2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;dashed=1;strokeColor=#8e2b3e;fontColor=#6b1f2e;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.418;entryDx=0;entryDy=0;" parent="1" source="IN2" target="BOX" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Ope3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;dashed=1;strokeColor=#8e2b3e;fontColor=#6b1f2e;exitX=1;exitY=0.204;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="BOX" target="OUT1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="Knowledge Lifecycle" name="Knowledge Lifecycle (State Machine)">
        <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="esm_0"/>
                <mxCell id="esm_1" parent="esm_0"/>
                <mxCell id="esm_t" value="Knowledge Lifecycle (State Machine)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" parent="esm_1" vertex="1">
                    <mxGeometry x="60" y="24" width="1300" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="esm_ts" value="State transitions are governed by weighted evidence and test verification. All transition conditions are specified within the blocks. Operators intervene only via veto tools (Pin, Dispute, Retire)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" parent="esm_1" vertex="1">
                    <mxGeometry x="60" y="62" width="1340" height="36" as="geometry"/>
                </mxCell>

                <!-- 1. DRAFT -->
                <mxCell id="est_draft" value="Draft&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;status: draft · No ID minted&lt;br&gt;&lt;br&gt;• Captured by agent during active task with evidence&lt;br&gt;• Mandatory refutation oracle (refutableBy)&lt;br&gt;• &lt;b&gt;Entry into circulation:&lt;/b&gt; fast CI validation in 1–2 min&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#fff1d6;strokeColor=#c47d18;strokeWidth=2;fontColor=#704406;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" parent="esm_1" vertex="1">
                    <mxGeometry x="60" y="150" width="300" height="130" as="geometry"/>
                </mxCell>

                <!-- 2. ENTRY (UNCONFIRMED) -->
                <mxCell id="est_unconfirmed" value="Circulating Entry (Unconfirmed)&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;status: entry · ID minted (KB-*) · trust: medium-low&lt;br&gt;&lt;br&gt;• Immediately searchable for all working agents&lt;br&gt;• Accumulates corroboration from active agent sessions&lt;br&gt;• &lt;b&gt;Promotion to Confirmed:&lt;/b&gt; score ≥ 6 and QA release tests&lt;br&gt;• &lt;b&gt;Drift to Disputed:&lt;/b&gt; upon code drift or contradiction&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontColor=#0d47a1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" parent="esm_1" vertex="1">
                    <mxGeometry x="450" y="150" width="340" height="130" as="geometry"/>
                </mxCell>

                <!-- 3. CONFIRMED -->
                <mxCell id="est_confirmed" value="Confirmed Entry&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;status: entry · score ≥ 6 · trust: high&lt;br&gt;&lt;br&gt;• Verified by code AST and platform QA release suites&lt;br&gt;• Served in search results without caveat warnings&lt;br&gt;• &lt;b&gt;Drift to Disputed:&lt;/b&gt; upon public contract changes in code&lt;br&gt;• &lt;b&gt;Lock (Pin):&lt;/b&gt; operator fixation as business invariant&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontColor=#1b5e20;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" parent="esm_1" vertex="1">
                    <mxGeometry x="880" y="150" width="340" height="130" as="geometry"/>
                </mxCell>

                <!-- 7. PINNED OVERLAY -->
                <mxCell id="est_pinned" value="Invariant (Pinned Overlay)&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;overlay: pinned · Set by human operator only&lt;br&gt;&lt;br&gt;• Protects critical business rules from machine changes&lt;br&gt;• Immutable: engine cannot edit, demote, or retire&lt;br&gt;• Disputes and usage observations continue logging in digest&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;strokeWidth=2;fontColor=#f57f17;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;dashed=1;" parent="esm_1" vertex="1">
                    <mxGeometry x="1270" y="150" width="290" height="130" as="geometry"/>
                </mxCell>

                <!-- 4. DISPUTED OVERLAY -->
                <mxCell id="est_disputed" value="Disputed (Arbitration Overlay)&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;overlay: disputed · Trust temporarily reset to zero&lt;br&gt;&lt;br&gt;• Triggered by code anchor drift or contradicting evidence&lt;br&gt;• Search symmetrically presents both contesting sides&lt;br&gt;• Enqueued into QA re-verification queue automatically&lt;br&gt;• &lt;b&gt;Outcome:&lt;/b&gt; return to Confirmed or replacement (Superseded)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontColor=#b71c1c;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;dashed=1;" parent="esm_1" vertex="1">
                    <mxGeometry x="670" y="380" width="340" height="140" as="geometry"/>
                </mxCell>

                <!-- 5. SUPERSEDED -->
                <mxCell id="est_superseded" value="Superseded (Archived)&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;status: superseded · Historical archive&lt;br&gt;&lt;br&gt;• Obsolete fact displaced by newer confirmed knowledge&lt;br&gt;• Retains immutable pointer to successor entry ID&lt;br&gt;• Automatically omitted from default search results&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#ede7f6;strokeColor=#512da8;strokeWidth=2;fontColor=#311b92;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" parent="esm_1" vertex="1">
                    <mxGeometry x="1100" y="450" width="340" height="130" as="geometry"/>
                </mxCell>

                <!-- 6. RETIRED -->
                <mxCell id="est_retired" value="Retired (Tombstone)&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;status: retired · Permanent trace kept&lt;br&gt;&lt;br&gt;• Deprecated by operator veto or feature deleted from codebase&lt;br&gt;• Completely excluded from active search results&lt;br&gt;• Protected against automated recreation by the engine&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;fillColor=#eceff1;strokeColor=#455a64;strokeWidth=2;fontColor=#263238;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" parent="esm_1" vertex="1">
                    <mxGeometry x="250" y="450" width="340" height="130" as="geometry"/>
                </mxCell>

                <!-- CLEAN EDGES (NO LABELS) -->
                <mxCell id="etr_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1976d2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="esm_1" source="est_draft" target="est_unconfirmed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="etr_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="esm_1" source="est_unconfirmed" target="est_confirmed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="etr_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#fbc02d;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="esm_1" source="est_confirmed" target="est_pinned" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="etr_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#c62828;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="sm_1" source="est_unconfirmed" target="est_disputed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="etr_3b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#c62828;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="sm_1" source="est_confirmed" target="est_disputed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="etr_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#2e7d32;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" parent="sm_1" source="est_disputed" target="est_confirmed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="etr_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#512da8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="sm_1" source="est_disputed" target="est_superseded" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="etr_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#455a64;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="sm_1" source="est_disputed" target="est_retired" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>