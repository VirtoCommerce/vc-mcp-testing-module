        </mxGraphModel>
    </diagram>
    <diagram id="The reference desk" name="Knowledge Resolver">
        <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1460" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="Knowledge Resolver — Unified Access &amp; Capture Gateway" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="24" width="1300" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="ts" value="An agent never reaches into a base itself: a question and a new piece of knowledge go through the same door — and both hit the search first. That is what makes &quot;do we already have this?&quot; impossible to skip: it is not a rule laid on top of writing, it is writing’s first step." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="62" width="1340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="IN1" value="From the agent&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;a steady flow&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="220" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="IN1-b" value="•&amp;nbsp; a question in the agent’s own words&lt;br&gt;•&amp;nbsp; new knowledge — with evidence&lt;br&gt;•&amp;nbsp; a confirmation of, or a dispute with, a record" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN1" vertex="1">
                    <mxGeometry y="52" width="340" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="BOX" value="A shared search, then the fork" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="440" y="190" width="610" height="690" as="geometry"/>
                </mxCell>
                <mxCell id="A" value="Searches&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the first step on both paths&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="220" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="A-b" value="•&amp;nbsp; asks every base there is&lt;br&gt;•&amp;nbsp; the search is deterministic and learns nothing&lt;br&gt;•&amp;nbsp; it invents nothing: what is absent stays absent&lt;br&gt;•&amp;nbsp; searches the index; reads the drafts directly" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="A" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="B" value="Assembles the answer&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;by rules&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="430" width="270" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="B-b" value="•&amp;nbsp; a project rule outranks a platform rule&lt;br&gt;•&amp;nbsp; never serves a platform rule the project cancelled&lt;br&gt;•&amp;nbsp; leaves superseded records out&lt;br&gt;•&amp;nbsp; hands a dispute over as both sides" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="B" vertex="1">
                    <mxGeometry y="52" width="270" height="148" as="geometry"/>
                </mxCell>
                <mxCell id="C" value="Attaches the trust label&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;loud exactly where trust is thin&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="680" width="270" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="C-b" value="•&amp;nbsp; high trust — just the answer&lt;br&gt;•&amp;nbsp; partial — with a warning&lt;br&gt;•&amp;nbsp; no answer — &quot;don’t know&quot;, leads kept separate" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="C" vertex="1">
                    <mxGeometry y="52" width="270" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="D" value="Takes in what is new&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the second branch&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="780" y="430" width="250" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="D-b" value="•&amp;nbsp; the same fact counts as a confirmation; no record is created&lt;br&gt;•&amp;nbsp; contradicts an existing record — it opens a dispute&lt;br&gt;•&amp;nbsp; genuinely new — it lands as a draft&lt;br&gt;•&amp;nbsp; no evidence, or no way to refute it — not accepted" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="D" vertex="1">
                    <mxGeometry y="52" width="250" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="BASES" value="The knowledge bases&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;however many there are&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1090" y="300" width="330" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="BASES-b" value="•&amp;nbsp; answer the search: records and leads&lt;br&gt;•&amp;nbsp; take a draft, a confirmation, a dispute&lt;br&gt;•&amp;nbsp; writes into its project’s base and no other" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="BASES">
                    <mxGeometry y="52" width="330" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1" value="To the agent&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;on every question&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="690" width="330" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1-b" value="•&amp;nbsp; the answer and where it came from&lt;br&gt;•&amp;nbsp; how far to trust it&lt;br&gt;•&amp;nbsp; leads — separately, as non-facts" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT1" vertex="1">
                    <mxGeometry y="52" width="330" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="Spr1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.567;entryDx=0;entryDy=0;" parent="1" source="IN1" target="A" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;startArrow=classic;startFill=1;exitX=1;exitY=0.667;exitDx=0;exitDy=0;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" parent="1" source="A" target="BASES" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.241;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="A" target="B" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.777;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="A" target="D" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="B" target="C" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
