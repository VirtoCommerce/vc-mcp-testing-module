    <diagram id="The reference desk" name="The reference desk">
        <mxGraphModel dx="1658" dy="770" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="The reference desk — the single door to knowledge, both ways" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="24" width="1300" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="ts" value="An agent never reaches into a base itself: a question and a new piece of knowledge go through the same door — and both hit the search first. That is what makes &quot;do we already have this?&quot; impossible to skip: it is not a rule laid on top of writing, it is writing’s first step." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="62" width="1340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="IN1" value="From the agent&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;a steady flow&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="220" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="IN1-b" value="•&amp;nbsp; a question in the agent’s own words&lt;br&gt;•&amp;nbsp; new knowledge — with evidence&lt;br&gt;•&amp;nbsp; a confirmation of, or a dispute with, a record" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN1" vertex="1">
                    <mxGeometry y="52" width="340" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="BOX" value="A shared search, then the fork" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="440" y="190" width="610" height="690" as="geometry"/>
                </mxCell>
                <mxCell id="A" value="Searches&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the first step on both paths&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="220" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="A-b" value="•&amp;nbsp; asks every base there is&lt;br&gt;•&amp;nbsp; the search is deterministic and learns nothing&lt;br&gt;•&amp;nbsp; it invents nothing: what is absent stays absent" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="A" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="B" value="Assembles the answer&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;by rules&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="430" width="270" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="B-b" value="•&amp;nbsp; a project rule outranks a platform rule&lt;br&gt;•&amp;nbsp; never serves a platform rule the project cancelled&lt;br&gt;•&amp;nbsp; leaves superseded records out&lt;br&gt;•&amp;nbsp; hands a dispute over as both sides" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="B" vertex="1">
                    <mxGeometry y="52" width="270" height="148" as="geometry"/>
                </mxCell>
                <mxCell id="C" value="Attaches the trust label&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;loud exactly where trust is thin&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="680" width="270" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="C-b" value="•&amp;nbsp; high trust — just the answer&lt;br&gt;•&amp;nbsp; partial — with a warning&lt;br&gt;•&amp;nbsp; no answer — &quot;don’t know&quot;, leads kept separate" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="C" vertex="1">
                    <mxGeometry y="52" width="270" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="D" value="Takes in what is new&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the second branch&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="780" y="430" width="250" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="D-b" value="•&amp;nbsp; the same fact counts as a confirmation; no record is created&lt;br&gt;•&amp;nbsp; contradicts an existing record — it opens a dispute&lt;br&gt;•&amp;nbsp; genuinely new — it lands as a draft&lt;br&gt;•&amp;nbsp; no evidence, or no way to refute it — not accepted" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="D" vertex="1">
                    <mxGeometry y="52" width="250" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="BASES" value="The knowledge bases&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;however many there are&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
                    <mxGeometry x="1090" y="300" width="330" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="BASES-b" value="•&amp;nbsp; answer the search: records and leads&lt;br&gt;•&amp;nbsp; take a draft, a confirmation, a dispute&lt;br&gt;•&amp;nbsp; writes into its project’s base and no other" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="BASES">
                    <mxGeometry y="52" width="330" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1" value="To the agent&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;on every question&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="690" width="330" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1-b" value="•&amp;nbsp; the answer and where it came from&lt;br&gt;•&amp;nbsp; how far to trust it&lt;br&gt;•&amp;nbsp; leads — separately, as non-facts" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT1" vertex="1">
                    <mxGeometry y="52" width="330" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="Spr1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.567;entryDx=0;entryDy=0;" parent="1" source="IN1" target="A" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;startArrow=classic;startFill=1;exitX=1;exitY=0.667;exitDx=0;exitDy=0;entryX=0;entryY=0.125;entryDx=0;entryDy=0;" parent="1" source="A" target="BASES" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.241;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="A" target="B" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.777;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="A" target="D" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="B" target="C" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.441;entryDx=0;entryDy=0;" parent="1" source="C" target="OUT1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Spr7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.48;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="D" target="BASES" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1060" y="550"/>
                            <mxPoint x="1060" y="420"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="The assistant agent" name="The assistant agent">
        <mxGraphModel dx="1658" dy="770" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1020" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="The assistant agent — who fills the base, and on what terms" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="24" width="1300" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="ts" value="The only party that sees the live product, and therefore the only source of new knowledge. It does not write down everything: only what will serve someone else, only with evidence, and only once it has named what could refute it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="62" width="1340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="IN1" value="From the person&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;a task or a question&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="210" width="340" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="IN1-b" value="•&amp;nbsp; what needs doing&lt;br&gt;•&amp;nbsp; a question that needs an answer" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN1" vertex="1">
                    <mxGeometry y="52" width="340" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="IN2" value="From the reference desk&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;on every request&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="380" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="IN2-b" value="•&amp;nbsp; the answer and where it came from&lt;br&gt;•&amp;nbsp; how far to trust it&lt;br&gt;•&amp;nbsp; leads, when there is no answer&lt;br&gt;•&amp;nbsp; a request to re-check what you are relying on" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN2" vertex="1">
                    <mxGeometry y="52" width="340" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="IN3" value="The product&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;what can be seen first-hand&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="600" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="IN3-b" value="•&amp;nbsp; code and schemas&lt;br&gt;•&amp;nbsp; the live environment: open it, click, measure&lt;br&gt;•&amp;nbsp; documents and team decisions" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN3" vertex="1">
                    <mxGeometry y="52" width="340" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="BOX" value="Doing the work and observing it are one activity" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="440" y="190" width="610" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="A" value="Asks before working&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;cheaper than working it out again&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="220" width="560" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="A-b" value="•&amp;nbsp; asks in its own words, not by record number&lt;br&gt;•&amp;nbsp; high trust — it takes the answer and gets on&lt;br&gt;•&amp;nbsp; partial — it verifies for itself before leaning on it" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="A" vertex="1">
                    <mxGeometry y="52" width="560" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="B" value="Does the task and cross-checks&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;along the way, not as a separate step&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="400" width="560" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="B-b" value="•&amp;nbsp; fixes, tests, explains&lt;br&gt;•&amp;nbsp; checks what the base says against what the product shows&lt;br&gt;•&amp;nbsp; a discrepancy is a finding, not an obstacle" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="B" vertex="1">
                    <mxGeometry y="52" width="560" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="C" value="Writes down what is new&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;only what will serve someone else&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="580" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="C-b" value="•&amp;nbsp; with evidence: what was seen, where, and what backs it&lt;br&gt;•&amp;nbsp; names what could refute it — otherwise it is not accepted&lt;br&gt;•&amp;nbsp; a defect with a ticket is not written down: the tracker owns it" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="C" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="D" value="Confirms and disputes&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the cheapest part, and the most useful&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="770" width="560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="D-b" value="•&amp;nbsp; relied on a record and it held — it confirms the record&lt;br&gt;•&amp;nbsp; it diverged from the product — it disputes, with evidence&lt;br&gt;•&amp;nbsp; saw the same thing again — that is a confirmation, not a new record" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" parent="D" vertex="1">
                    <mxGeometry y="52" width="560" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1" value="To the person&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the result of the work&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="400" width="330" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1-b" value="•&amp;nbsp; what was done&lt;br&gt;•&amp;nbsp; what it leaned on, and how far to trust that" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT1" vertex="1">
                    <mxGeometry y="52" width="330" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="OUT2" value="To the reference desk&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;through the single door&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1090" y="700" width="330" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="OUT2-b" value="•&amp;nbsp; new knowledge — as a draft&lt;br&gt;•&amp;nbsp; a confirmation of a record&lt;br&gt;•&amp;nbsp; a dispute with a record" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT2" vertex="1">
