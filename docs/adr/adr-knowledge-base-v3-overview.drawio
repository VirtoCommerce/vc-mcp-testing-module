<mxfile host="app.diagrams.net" agent="scripts/docs/gen-kb-v3-diagrams.mjs" version="24.0.0">
  <diagram id="Общий вид" name="Общий вид">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1040" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Как это работает — общий вид" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="Кто с кем разговаривает и что кому передаёт. Каждый блок потом раскрывается отдельной схемой — по запросу.&lt;br&gt;Сплошные стрелки — то, что происходит само, без людей. Пунктирная стрелка — редкое вмешательство человека.&lt;br&gt;Пунктирная рамка — блок есть не всегда." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="HUM" value="Человек&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;менеджер · разработчик&lt;br&gt;тестировщик · аналитик&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=68;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="HUM-b" value="•&amp;nbsp; ставит задачу&lt;br&gt;•&amp;nbsp; задаёт вопрос&lt;br&gt;•&amp;nbsp; получает ответ с пояснением" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" vertex="1" parent="HUM">
          <mxGeometry x="0" y="68" width="240" height="82" as="geometry" />
        </mxCell>
        <mxCell id="AGT" value="Агент-помощник" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="180" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="AGT-b" value="•&amp;nbsp; делает задачу: чинит, проверяет, объясняет&lt;br&gt;•&amp;nbsp; спрашивает базу перед работой&lt;br&gt;•&amp;nbsp; записывает новое — с доказательством&lt;br&gt;•&amp;nbsp; спорит, если база расходится с продуктом&lt;br&gt;•&amp;nbsp; поясняет человеку, откуда взят ответ" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" vertex="1" parent="AGT">
          <mxGeometry x="0" y="36" width="310" height="124" as="geometry" />
        </mxCell>
        <mxCell id="WIN" value="Справочная&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;единая дверь к знаниям&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="400" width="310" height="165" as="geometry" />
        </mxCell>
        <mxCell id="WIN-b" value="•&amp;nbsp; принимает все вопросы&lt;br&gt;•&amp;nbsp; собирает ответ из доступных баз&lt;br&gt;•&amp;nbsp; показывает обе стороны при переопределении&lt;br&gt;•&amp;nbsp; говорит, насколько ответу верить&lt;br&gt;•&amp;nbsp; говорит «не знаю», если ответа нет" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="WIN">
          <mxGeometry x="0" y="52" width="310" height="113" as="geometry" />
        </mxCell>
        <mxCell id="OPT" value="Есть только у клиентского проекта" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="760" y="395" width="710" height="270" as="geometry" />
        </mxCell>
        <mxCell id="KBP" value="База знаний платформы&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;верное для любого проекта&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="200" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="KBP-b" value="•&amp;nbsp; отвечает справочной напрямую&lt;br&gt;•&amp;nbsp; отдаёт знания проектам&lt;br&gt;•&amp;nbsp; принимает предложения проектов как черновики" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" vertex="1" parent="KBP">
          <mxGeometry x="0" y="52" width="340" height="73" as="geometry" />
        </mxCell>
        <mxCell id="KBC" value="База знаний клиентского проекта&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;верное только для этого проекта&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="435" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="KBC-b" value="•&amp;nbsp; отвечает справочной напрямую&lt;br&gt;•&amp;nbsp; читает общее&lt;br&gt;•&amp;nbsp; переопределяет правила платформы у себя&lt;br&gt;•&amp;nbsp; отменяет неприменимые правила&lt;br&gt;•&amp;nbsp; дополняет общие правила&lt;br&gt;•&amp;nbsp; не меняет общую базу&lt;br&gt;•&amp;nbsp; предлагает наверх верное для всех" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" vertex="1" parent="KBC">
          <mxGeometry x="0" y="52" width="340" height="138" as="geometry" />
        </mxCell>
        <mxCell id="KEEP" value="Механизм проверки и обновления&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;работает сам, без людей&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="640" width="310" height="180" as="geometry" />
        </mxCell>
        <mxCell id="KEEP-b" value="•&amp;nbsp; принимает новое только с доказательством&lt;br&gt;•&amp;nbsp; кладёт подтверждённое в базу&lt;br&gt;•&amp;nbsp; перепроверяет старое по изменениям и по кругу&lt;br&gt;•&amp;nbsp; заменяет устаревшее, старое сохраняет&lt;br&gt;•&amp;nbsp; помечает спорное, разрешает споры проверкой&lt;br&gt;•&amp;nbsp; сообщает человеку, что изменилось" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="KEEP">
          <mxGeometry x="0" y="52" width="310" height="128" as="geometry" />
        </mxCell>
        <mxCell id="OPP" value="Оператор платформы&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;сотрудник Virto&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1180" y="200" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="OPP-b" value="•&amp;nbsp; убирает неверное&lt;br&gt;•&amp;nbsp; закрепляет важное&lt;br&gt;•&amp;nbsp; ставит под сомнение&lt;br&gt;•&amp;nbsp; читает сводку изменений&lt;br&gt;•&amp;nbsp; вмешивается редко" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" vertex="1" parent="OPP">
          <mxGeometry x="0" y="52" width="270" height="108" as="geometry" />
        </mxCell>
        <mxCell id="OPC" value="Оператор проекта&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;сотрудник клиента&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1180" y="435" width="270" height="160" as="geometry" />
        </mxCell>
        <mxCell id="OPC-b" value="•&amp;nbsp; убирает неверное&lt;br&gt;•&amp;nbsp; закрепляет важное&lt;br&gt;•&amp;nbsp; ставит под сомнение&lt;br&gt;•&amp;nbsp; читает сводку изменений&lt;br&gt;•&amp;nbsp; вмешивается редко" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" vertex="1" parent="OPC">
          <mxGeometry x="0" y="52" width="270" height="108" as="geometry" />
        </mxCell>
        <mxCell id="SRC" value="Источники&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;код · стенд · документация · решения команды&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="SRC-b" value="•&amp;nbsp; наполняют базу в первый раз&lt;br&gt;•&amp;nbsp; служат проверкой для всех знаний" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="SRC">
          <mxGeometry x="0" y="52" width="600" height="48" as="geometry" />
