<mxfile host="app.diagrams.net" agent="scripts/docs/gen-kb-v3-diagrams.mjs" version="24.0.0">
  <diagram id="Общий вид" name="Общий вид">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1010" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Как это работает — общий вид" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="Кто с кем разговаривает и что кому передаёт. Каждый блок потом раскрывается отдельной схемой — по запросу.&lt;br&gt;Сплошные стрелки — то, что происходит само, без людей. Пунктирная — редкое вмешательство человека." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1100" height="44" as="geometry" />
        </mxCell>
        <mxCell id="HUM" value="Человек" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="HUM-b" value="•&amp;nbsp; менеджер · разработчик · тестировщик · аналитик&lt;br&gt;•&amp;nbsp; ставит задачу&lt;br&gt;•&amp;nbsp; задаёт вопрос&lt;br&gt;•&amp;nbsp; получает ответ с пояснением" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" vertex="1" parent="HUM">
          <mxGeometry x="0" y="36" width="240" height="114" as="geometry" />
        </mxCell>
        <mxCell id="AGT" value="Агент-помощник" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#f5dfc8;swimlaneFillColor=#fdf6ef;strokeColor=#8f4a1b;fontColor=#8f4a1b;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="180" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="AGT-b" value="•&amp;nbsp; делает задачу: чинит, проверяет, объясняет&lt;br&gt;•&amp;nbsp; спрашивает базу перед работой&lt;br&gt;•&amp;nbsp; поясняет ответ человеку&lt;br&gt;•&amp;nbsp; записывает то, что узнал" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#8f4a1b;fontFamily=Helvetica;" vertex="1" parent="AGT">
          <mxGeometry x="0" y="36" width="300" height="114" as="geometry" />
        </mxCell>
        <mxCell id="WIN" value="Одно окно к знаниям" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="390" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="WIN-b" value="•&amp;nbsp; принимает все вопросы&lt;br&gt;•&amp;nbsp; отвечает из обеих баз&lt;br&gt;•&amp;nbsp; говорит, насколько ответу верить&lt;br&gt;•&amp;nbsp; говорит «не знаю», если ответа нет" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="WIN">
          <mxGeometry x="0" y="36" width="300" height="114" as="geometry" />
        </mxCell>
        <mxCell id="KNOW" value="Хранилище знаний — баз две, для спрашивающего это одно целое" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9db3ad;dashed=1;verticalAlign=top;align=center;spacingTop=8;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="750" y="150" width="390" height="400" as="geometry" />
        </mxCell>
        <mxCell id="KBP" value="Знания о платформе" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="200" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="KBP-b" value="•&amp;nbsp; хранит верное для любого проекта&lt;br&gt;•&amp;nbsp; отдаёт общее проектам" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" vertex="1" parent="KBP">
          <mxGeometry x="0" y="36" width="350" height="74" as="geometry" />
        </mxCell>
        <mxCell id="KBC" value="Знания о проекте клиента" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="370" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="KBC-b" value="•&amp;nbsp; хранит верное только для этого проекта&lt;br&gt;•&amp;nbsp; читает общее&lt;br&gt;•&amp;nbsp; не меняет общее&lt;br&gt;•&amp;nbsp; отдаёт наверх верное для всех" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" vertex="1" parent="KBC">
          <mxGeometry x="0" y="36" width="350" height="114" as="geometry" />
        </mxCell>
        <mxCell id="KEEP" value="Проверяющий механизм" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="350" y="620" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="KEEP-b" value="•&amp;nbsp; принимает новое только с доказательством&lt;br&gt;•&amp;nbsp; перепроверяет старое&lt;br&gt;•&amp;nbsp; помечает спорное&lt;br&gt;•&amp;nbsp; работает сам, без людей" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="KEEP">
          <mxGeometry x="0" y="36" width="300" height="114" as="geometry" />
        </mxCell>
        <mxCell id="OPER" value="Оператор" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#f0d3da;swimlaneFillColor=#faeff2;strokeColor=#7a2436;fontColor=#7a2436;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="830" y="600" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="OPER-b" value="•&amp;nbsp; убирает неверное&lt;br&gt;•&amp;nbsp; закрепляет важное&lt;br&gt;•&amp;nbsp; ставит под сомнение&lt;br&gt;•&amp;nbsp; читает сводку изменений&lt;br&gt;•&amp;nbsp; вмешивается редко" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#7a2436;fontFamily=Helvetica;" vertex="1" parent="OPER">
          <mxGeometry x="0" y="36" width="340" height="134" as="geometry" />
        </mxCell>
        <mxCell id="SRC" value="Источники правды — сам продукт" style="swimlane;html=1;rounded=1;arcSize=6;startSize=36;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="830" width="1110" height="120" as="geometry" />
        </mxCell>
        <mxCell id="SRC-b" value="•&amp;nbsp; код · работающий стенд · документация · записанные решения команды&lt;br&gt;•&amp;nbsp; наполняют базу в первый раз&lt;br&gt;•&amp;nbsp; служат проверкой для всех знаний" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="SRC">
