    <diagram id="Platform knowledge base" name="Platform knowledge base">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Platform knowledge base — three inputs, three outputs" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="The overview block, opened up: what comes in, what is done with it, what goes out. Inputs on the left, outputs on the right, arrow styles as on the overview. The third output is not drawn on the overview: the base confirms nothing by itself — the engine does the checking, and what it confirms returns through the first input." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="IN1" value="From the verification engine&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;a steady flow&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="IN1-b" value="•&amp;nbsp; a record that cleared the bar&lt;br&gt;•&amp;nbsp; a mark that supersedes an earlier one&lt;br&gt;•&amp;nbsp; a dispute mark" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="IN1">
          <mxGeometry x="0" y="52" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="IN2" value="From the platform operator&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;rarely, by hand&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="IN2-b" value="•&amp;nbsp; retiring a wrong record&lt;br&gt;•&amp;nbsp; pinning a record&lt;br&gt;•&amp;nbsp; putting a record in doubt&lt;br&gt;•&amp;nbsp; the rules for raising trust" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="IN2">
          <mxGeometry x="0" y="52" width="340" height="98" as="geometry" />
        </mxCell>
        <mxCell id="IN3" value="From a project base&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;on an explicit command&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="IN3-b" value="•&amp;nbsp; a proposal: a rule that holds for everyone&lt;br&gt;•&amp;nbsp; with every trace of the project stripped" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="IN3">
          <mxGeometry x="0" y="52" width="340" height="78" as="geometry" />
        </mxCell>
        <mxCell id="BOX" value="What happens inside" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="440" y="160" width="660" height="600" as="geometry" />
        </mxCell>
        <mxCell id="ACC" value="Intake&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;one rule per input&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="210" width="290" height="290" as="geometry" />
        </mxCell>
        <mxCell id="ACC-b" value="•&amp;nbsp; takes the engine's records as they are — it has already checked them&lt;br&gt;•&amp;nbsp; drops a superseded record from answers, keeps the history&lt;br&gt;•&amp;nbsp; applies the operator's mark and closes it to the machine&lt;br&gt;•&amp;nbsp; never files a project's proposal into the shared records&lt;br&gt;•&amp;nbsp; accepts trust rules from its own operator only" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="ACC">
          <mxGeometry x="0" y="52" width="290" height="238" as="geometry" />
        </mxCell>
        <mxCell id="DRAFT" value="Drafts&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;taken in, not yet reconciled with the base&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="470" y="540" width="290" height="185" as="geometry" />
        </mxCell>
        <mxCell id="DRAFT-b" value="•&amp;nbsp; sits here until the engine's next pass&lt;br&gt;•&amp;nbsp; served only as a lead, marked &quot;not a fact&quot;&lt;br&gt;•&amp;nbsp; cleared by the platform's own evidence, never by trust in whoever wrote it&lt;br&gt;•&amp;nbsp; the same engine checks them — the base confirms nothing by itself" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="DRAFT">
          <mxGeometry x="0" y="52" width="290" height="133" as="geometry" />
        </mxCell>
        <mxCell id="STORE" value="Shared records&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;what the base answers with&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="210" width="280" height="225" as="geometry" />
        </mxCell>
        <mxCell id="STORE-b" value="•&amp;nbsp; one current state per subject&lt;br&gt;•&amp;nbsp; the history of what was replaced and retired&lt;br&gt;•&amp;nbsp; permanent numbers — other records cite them&lt;br&gt;•&amp;nbsp; every record carries a weight; &quot;confirmed&quot; is a weight above the threshold&lt;br&gt;•&amp;nbsp; serves only what is in force, with its trust label" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" vertex="1" parent="STORE">
          <mxGeometry x="0" y="52" width="280" height="173" as="geometry" />
        </mxCell>
        <mxCell id="OUT1" value="To the reference desk&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;on request&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1160" y="231" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="OUT1-b" value="•&amp;nbsp; records for the agent's answer&lt;br&gt;•&amp;nbsp; the trust label and the source" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="OUT1">
          <mxGeometry x="0" y="52" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="OUT3" value="To the verification engine&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;continuously&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1160" y="620" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="OUT3-b" value="•&amp;nbsp; drafts, for checking&lt;br&gt;•&amp;nbsp; records due for a re-check&lt;br&gt;•&amp;nbsp; what clears comes back through the first input" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="OUT3">
          <mxGeometry x="0" y="52" width="300" height="98" as="geometry" />
        </mxCell>
        <mxCell id="OUT2" value="To project bases&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;continuously&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1160" y="430" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="OUT2-b" value="•&amp;nbsp; the shared records in full&lt;br&gt;•&amp;nbsp; a project layers over them instead of copying them" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="OUT2">
          <mxGeometry x="0" y="52" width="300" height="78" as="geometry" />
        </mxCell>
