  </diagram>
  <diagram id="The verification engine" name="The verification engine">
        <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1440" pageHeight="940" math="0" shadow="0" adaptiveColors="auto">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" value="The verification engine — what it reads, what it does, what it writes" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="24" width="1300" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="ts" value="The engine holds no truth of its own. It can rebuild from a source, check anchors, count independent confirmations and apply rules — nothing else. Anything that needs a live environment it hands to an agent." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="62" width="1340" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="IN1" value="Sources&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;what is actually the case&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="210" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="IN1-b" value="•&amp;nbsp; code, schemas, configuration&lt;br&gt;•&amp;nbsp; documents and team decisions&lt;br&gt;•&amp;nbsp; the live environment is out of its reach — an agent goes there" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN1" vertex="1">
                    <mxGeometry y="52" width="340" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="IN2" value="Its own knowledge base&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;one; it never touches another&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="60" y="420" width="340" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="IN2-b" value="•&amp;nbsp; drafts&lt;br&gt;•&amp;nbsp; records due for a re-check&lt;br&gt;•&amp;nbsp; the operator’s trust thresholds" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="IN2" vertex="1">
                    <mxGeometry y="52" width="340" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="BOX" value="Four actions, every one of them by rule" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="440" y="180" width="520" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="A" value="Rebuilds from the source&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;deterministic, no model&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="220" width="460" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="A-b" value="•&amp;nbsp; extracts contracts and structure afresh&lt;br&gt;•&amp;nbsp; compares against the previous run&lt;br&gt;•&amp;nbsp; a change IS the list of what to re-check" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="A" vertex="1">
                    <mxGeometry y="52" width="460" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="B" value="Checks the anchors&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;is what was cited still there&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="400" width="460" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="B-b" value="•&amp;nbsp; a record names the fragment of the source it rests on&lt;br&gt;•&amp;nbsp; if it moved, the record goes up for a re-check&lt;br&gt;•&amp;nbsp; what needs the live environment goes into an agent’s queue" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="B" vertex="1">
                    <mxGeometry y="52" width="460" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="C" value="Counts the weight&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;it decides nothing about truth itself&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="570" width="460" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="C-b" value="•&amp;nbsp; adds up independent confirmations&lt;br&gt;•&amp;nbsp; a repeat from the same session does not count&lt;br&gt;•&amp;nbsp; a contradiction opens a dispute: trust drops to none on both sides" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="C" vertex="1">
                    <mxGeometry y="52" width="460" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="D" value="The run gates&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;by batch, with a revert&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="470" y="740" width="460" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="D-b" value="•&amp;nbsp; an anomalous batch goes to quarantine&lt;br&gt;•&amp;nbsp; an exam on known answers; failed means the whole batch is reverted&lt;br&gt;•&amp;nbsp; no more than the per-run quota is promoted" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" parent="D" vertex="1">
                    <mxGeometry y="52" width="460" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1" value="Into its own base&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;after the gates&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="690" width="340" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="OUT1-b" value="•&amp;nbsp; what cleared the bar, and the new numbers&lt;br&gt;•&amp;nbsp; supersede and dispute marks&lt;br&gt;•&amp;nbsp; the re-check queue" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT1" vertex="1">
                    <mxGeometry y="52" width="340" height="103" as="geometry"/>
                </mxCell>
                <mxCell id="OUT2" value="To the operator&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;every run&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="420" width="340" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="OUT2-b" value="•&amp;nbsp; the digest: what was applied, what was reverted&lt;br&gt;•&amp;nbsp; reading is optional" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" parent="OUT2" vertex="1">
                    <mxGeometry y="52" width="340" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="Meh1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.433;entryDx=0;entryDy=0;" parent="1" source="IN1" target="A" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Meh2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.857;entryDx=0;entryDy=0;" parent="1" source="IN2" target="B" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Meh3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="A" target="B" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Meh4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="B" target="C" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="Meh5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="C" target="D" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
