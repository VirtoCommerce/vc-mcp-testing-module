  <diagram id="Two knowledge bases" name="Two knowledge bases">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="910" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Two knowledge bases — the shared one and the project one" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#16211e;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="1400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="Each stands on its own: its own shelves, its own verification engine, its own operator. Exactly two links join them, and they differ in kind: shared records travel down continuously, a proposal travels up only on an explicit command." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5c57;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="1480" height="56" as="geometry" />
        </mxCell>
        <mxCell id="WIN" value="The reference desk&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;one desk for both bases&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="WIN-b" value="•&amp;nbsp; asks both bases&lt;br&gt;•&amp;nbsp; files a draft into its project’s base only&lt;br&gt;•&amp;nbsp; a project never writes into the shared base" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="WIN">
          <mxGeometry x="0" y="52" width="300" height="178" as="geometry" />
        </mxCell>
        <mxCell id="PBOX" value="The platform knowledge base" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="420" y="190" width="560" height="460" as="geometry" />
        </mxCell>
        <mxCell id="PD" value="Drafts&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;not yet reconciled&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="240" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="PD-b" value="•&amp;nbsp; what platform agents found&lt;br&gt;•&amp;nbsp; proposals from projects land here too, never in the records&lt;br&gt;•&amp;nbsp; waiting for the engine’s pass" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="PD">
          <mxGeometry x="0" y="52" width="500" height="78" as="geometry" />
        </mxCell>
        <mxCell id="PM" value="Shared records&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;true for any project&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="400" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="PM-b" value="•&amp;nbsp; rules and facts about the platform itself&lt;br&gt;•&amp;nbsp; they know nothing about any particular project&lt;br&gt;•&amp;nbsp; permanent numbers — projects cite them&lt;br&gt;•&amp;nbsp; a proposal is confirmed by the platform’s own evidence only" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" vertex="1" parent="PM">
          <mxGeometry x="0" y="52" width="500" height="128" as="geometry" />
        </mxCell>
        <mxCell id="CBOX" value="The client project’s knowledge base — not always present" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7d8d87;dashed=1;dashPattern=8 5;strokeWidth=2;verticalAlign=bottom;align=center;spacingBottom=6;fontColor=#4b5c57;fontStyle=2;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="190" width="560" height="460" as="geometry" />
        </mxCell>
        <mxCell id="CD" value="Drafts&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;not yet reconciled&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#c9e4de;swimlaneFillColor=#eef7f5;strokeColor=#0d5f55;fontColor=#0d5f55;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1040" y="240" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="CD-b" value="•&amp;nbsp; what the project’s agents found&lt;br&gt;•&amp;nbsp; waiting for their own engine’s pass" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#0d5f55;fontFamily=Helvetica;" vertex="1" parent="CD">
          <mxGeometry x="0" y="52" width="500" height="78" as="geometry" />
        </mxCell>
        <mxCell id="CM" value="A layer over the platform&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;the differences only&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#dde5e3;swimlaneFillColor=#f4f7f6;strokeColor=#2b3d39;fontColor=#2b3d39;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1040" y="400" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="CM-b" value="•&amp;nbsp; overrides a platform rule&lt;br&gt;•&amp;nbsp; cancels what does not hold here&lt;br&gt;•&amp;nbsp; adds its own, where the platform has none&lt;br&gt;•&amp;nbsp; cites the platform record’s number and remembers its version&lt;br&gt;•&amp;nbsp; never writes into the shared base" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#2b3d39;fontFamily=Helvetica;" vertex="1" parent="CM">
          <mxGeometry x="0" y="52" width="500" height="148" as="geometry" />
        </mxCell>
        <mxCell id="PE" value="The platform engine&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;one per base&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="420" y="700" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PE-b" value="•&amp;nbsp; works through the platform’s drafts&lt;br&gt;•&amp;nbsp; re-checks its records&lt;br&gt;•&amp;nbsp; never writes into another base" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="PE">
          <mxGeometry x="0" y="52" width="560" height="98" as="geometry" />
        </mxCell>
        <mxCell id="CE" value="The project engine&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;one per base&lt;/span&gt;" style="swimlane;html=1;rounded=1;arcSize=6;startSize=52;horizontal=1;fillColor=#e2e8e6;swimlaneFillColor=#f6f8f7;strokeColor=#3f4d49;fontColor=#3f4d49;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="700" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="CE-b" value="•&amp;nbsp; works through the project’s drafts&lt;br&gt;•&amp;nbsp; re-checks the layer and the base it rests on&lt;br&gt;•&amp;nbsp; the base moved — it opens a dispute" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=14;spacingTop=10;spacingRight=10;fontSize=12;fontColor=#3f4d49;fontFamily=Helvetica;" vertex="1" parent="CE">
          <mxGeometry x="0" y="52" width="560" height="98" as="geometry" />
        </mxCell>
        <mxCell id="Dve1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;fontSize=12;strokeWidth=2;strokeColor=#3d5a55;fontColor=#2f3a37;fontFamily=Helvetica;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="WIN" target="PD">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
