    "seed:promotions:teardown": "node scripts/seed-data/seed-promotions.mjs --teardown",
    "seed:bopis": "node scripts/seed-data/seed-bopis.mjs",
    "seed:bopis:teardown": "node scripts/seed-data/seed-bopis.mjs --teardown",
