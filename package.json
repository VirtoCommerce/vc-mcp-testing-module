{
  "name": "vc-mcp-testing-module",
  "version": "0.7.0",
  "description": "",
  "main": "config.js",
  "scripts": {
    "env:check": "node get_variables_env.js",
    "plugin:configure": "npx tsx bootstrap/install.ts",
    "plugin:check": "npx tsx bootstrap/install.ts --check",
    "plugin:install": "echo '\"plugin:install\" was renamed to \"plugin:configure\" — Claude Code handles plugin install via /plugin install. Run npm run plugin:configure for env setup.' && exit 1",
    "ci:regression": "npx tsx ci/run-regression.ts",
    "ci:smoke": "cross-env SUITE_SELECTION=smoke npx tsx ci/run-regression.ts",
    "ci:critical": "cross-env SUITE_SELECTION=critical npx tsx ci/run-regression.ts",
    "ci:backend": "cross-env SUITE_SELECTION=backend npx tsx ci/run-regression.ts",
    "ci:frontend": "cross-env SUITE_SELECTION=frontend npx tsx ci/run-regression.ts",
    "ci:full": "cross-env SUITE_SELECTION=full MAX_BUDGET_USD=80 npx tsx ci/run-regression.ts",
    "ci:notify": "npx tsx ci/notify-teams.ts",
    "ci:cycle": "npx tsx ci/run-full-cycle.ts",
    "ci:cycle:pr": "cross-env CHANGE_SOURCE=\"PR #$PR_NUMBER\" npx tsx ci/run-full-cycle.ts",
    "ci:cycle:sync-only": "cross-env SKIP_LIFECYCLE=true SKIP_REGRESSION=true npx tsx ci/run-full-cycle.ts",
    "ci:cycle:no-sync": "cross-env SKIP_SYNC=true npx tsx ci/run-full-cycle.ts",
    "ci:fix": "npx tsx ci/run-fix-cycle.ts",
    "ci:fix:dry": "cross-env DRY_RUN=true npx tsx ci/run-fix-cycle.ts",
    "ci:monitor": "npx tsx ci/run-monitor.ts",
    "ci:monitor:dry": "cross-env DRY_RUN=true npx tsx ci/run-monitor.ts",
    "seed": "node scripts/seed-data/seed-bootstrap.mjs",
    "seed:minimal": "node scripts/seed-data/seed-bootstrap.mjs --skip-optional",
    "seed:catalog": "npm run seed:catalog-structure && npm run seed:products && npm run seed:inventory",
    "seed:full": "node scripts/seed-data/seed-bootstrap.mjs",
    "seed:bootstrap": "node scripts/seed-data/seed-bootstrap.mjs",
    "seed:bootstrap:teardown": "node scripts/seed-data/seed-bootstrap.mjs --teardown",
    "seed:catalog-structure": "node scripts/seed-data/seed-catalog.mjs",
    "seed:categories": "node scripts/seed-data/seed-catalog-categories.mjs",
