    "suites:lint": "npx tsx scripts/sync-test-suites.ts --check",
    "suites:append": "npx tsx scripts/append-test-cases-to-suite.ts",
    "suites:review": "npx tsx scripts/lint-test-cases.ts",
    "metrics:compute": "npx tsx scripts/compute-metrics.ts",
    "triage:collect": "npx tsx scripts/lib/regression-triage.ts collect",
    "triage:history": "npx tsx scripts/lib/regression-triage.ts history",
    "scope:validate": "npx tsx scripts/validate-critical-ui-scope.ts",
    "verify:multi-env": "npx tsx scripts/verify-multi-env-filters.ts",
    "verify:multi-env:report": "npx tsx scripts/verify-multi-env-filters.ts --write-report",
    "bundle:check": "npx tsx scripts/bundle-version-check.ts",
    "hotfix:precheck": "npx tsx scripts/hotfix-precheck.ts",
    "hotfix:release": "npx tsx scripts/hotfix-release.ts",
    "local:manifest": "node skills/qa-local-env/gen-manifest.mjs",
    "local:health": "node skills/qa-local-env/healthcheck.mjs",
    "seed:reviews": "node scripts/seed-data/seed-reviews.mjs",
