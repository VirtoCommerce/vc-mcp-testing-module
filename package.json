    "seed:inventory:teardown": "node scripts/seed-data/seed-inventory.mjs --teardown",
    "seed:loyalty": "node scripts/seed-data/seed-loyalty.mjs",
    "seed:loyalty:teardown": "node scripts/seed-data/seed-loyalty.mjs --teardown",
    "seed:loyalty-fixtures": "node scripts/seed-data/seed-loyalty-fixtures.mjs",
    "seed:loyalty-fixtures:teardown": "node scripts/seed-data/seed-loyalty-fixtures.mjs --teardown",
    "seed:loyalty-balance": "node scripts/seed-data/seed-loyalty-balance.mjs",
