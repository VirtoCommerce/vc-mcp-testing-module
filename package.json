    "seed:configurable:teardown": "node scripts/seed-data/seed-configurable.mjs --teardown",
    "seed:properties": "node scripts/seed-data/seed-catalog-properties.mjs",
    "seed:properties:teardown": "node scripts/seed-data/seed-catalog-properties.mjs --teardown",
    "seed:white-labeling": "node scripts/seed-data/seed-white-labeling.mjs",
    "seed:white-labeling:teardown": "node scripts/seed-data/seed-white-labeling.mjs --teardown",
    "seed:products": "node scripts/seed-data/seed-standard-products.mjs",
    "seed:configurable": "node scripts/seed-data/seed-configurable.mjs",
    "seed:configurable:conditional": "node scripts/seed-data/seed-configurable.mjs --group conditional",
    "seed:configurable:default": "node scripts/seed-data/seed-configurable.mjs --group default",
    "seed:configurable:bike": "node scripts/seed-data/seed-configurable.mjs --group bike",
    "seed:impersonation": "node scripts/seed-data/seed-company-users.mjs imp",
    "seed:loyalty:users": "node scripts/seed-data/seed-company-users.mjs loyalty",
