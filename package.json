    "td:validate:warn": "npx tsx scripts/validate-td-refs.ts --warn-only",
    "td:reconcile": "node scripts/seed-data/reconcile-test-data.mjs",
    "td:validate:b2b": "node scripts/seed-data/validate-b2b-data.mjs",
    "td:validate:cfg": "node scripts/seed-data/validate-configurable-data.mjs",
    "td:validate:standard": "node scripts/seed-data/validate-standard-data.mjs",
    "td:validate:loyalty": "node scripts/seed-data/validate-loyalty-data.mjs",
