{
  "name": "vc-kb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The knowledge base tool. Extracts the derived plane from a running deployment and resolves questions against it.",
  "bin": { "kb": "bin/kb.mjs" },
