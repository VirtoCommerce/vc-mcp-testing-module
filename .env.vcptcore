# ==============================================================================
# vcptcore-qa environment — second QA environment
# Activate: TEST_ENV=vcptcore npm run env:check
# Committed; URLs/identifiers only — secrets live in .env.local
#
# STATUS: scaffolded with TODO placeholders. Fill in real values as available;
# `npm run env:check` will fail loud for any required var still empty/TODO.
# ==============================================================================

# --- Deploy target (vc-deploy-dev branch for /qa-deploy-pr, /qa-hotfix-check) --
# The vcptcore-qa env deploys off the `vcptcore-qa` branch (not the env-name
# convention `vcptcore`, which does not exist on the repo).
DEPLOY_REPO=VirtoCommerce/vc-deploy-dev
DEPLOY_BRANCH=vcptcore-qa

# --- Application URLs --------------------------------------------------------
# TODO: confirm exact URLs (likely vcptcore-qa.govirto.com pattern)
FRONT_URL=https://vcptcore-qa-storefront.govirto.com
BACK_URL=https://vcptcore-qa.govirto.com/
STORYBOOK_URL=https://vcptcore-qa-storybook.govirto.com/
STORYBOOK_DEV_URL=https://vcptcore-qa-storybook.govirto.com/

# --- Store configuration -----------------------------------------------------
# TODO: confirm whether vcptcore uses the same B2B-store slug
STORE_ID=B2B-store
# Secondary store for Sales Rep store-scoping tests (existing Open store) — VCST-5293/050m
STORE_ID_SECONDARY=Electronics
# ORDER_KEYWORD_TOKEN promoted to .env.defaults (env-invariant seeded fixture) — 2026-07-17
STOREFRONT_DOMAIN=vcptcore-qa-storefront.govirto.com
# Contact GUID of USER_EMAIL below (user-roles.mjs USER.idVar). Follows USER_EMAIL — re-read it
# from `GET /api/platform/security/users/{USER_EMAIL}`.memberId after re-seeding this env.
TEST_USER_ID=c387d3ed-3cf2-435a-9244-1b2f53b53a0a

# --- User identifiers (passwords in .env.local) ------------------------------
ADMIN=admin
# Alias of ADMIN — many suite CSVs reference {{ADMIN_EMAIL}} as the OAuth
# username for /connect/token grant_type=password. Same value as ADMIN.
ADMIN_EMAIL=admin
# Admin SPA / platform backend URL — same host as BACK_URL (without trailing slash).
# Many suites use {{ADMIN_URL}} as a [NAV] target; kept as a separate alias
# so admin-only navigation can be retargeted per-env without touching BACK_URL.
ADMIN_URL=https://vcptcore-qa.govirto.com
# Primary storefront shopper (user-roles.mjs USER, kind=customer) — MUST be a PERSONAL,
# zero-organization contact: SMK-017 asserts the dashboard 'Addresses' link, which the storefront
# renders for personal accounts only. Was `mutykovaelena@gmail.com` — a human-shared Gmail that on
# THIS env had accumulated 29 organization associations (Bence and Family, [Cypress]-Corporate-1,
# [E2E Test] Contoso Ltd., Postman-*, …), so the storefront treated it as an org user and SMK-017
# was blocked in REG-2026-08-17-1030. NONE of those 29 orgs is AGENT-TEST-prefixed, so no seeder
# created them and no teardown can sweep them — the account cannot be repaired, only replaced.
# Same email on .env.vcst still has 0 orgs, which is why the drift was invisible from the primary env.
# Now a seeded agent-test account, matching the convention the other three role emails on this env
# already use (agent-test-*-vcpt@test-agent.com). Provisioned by `TEST_ENV=vcptcore npm run seed:users`
# via user-provision.mjs roleUsers() — identity here, secret from .env.local USER_PASSWORD. Declared
# ONCE (env-role only, no test-users.csv row), so `td:validate:credentials` [3] stays clean; pointing
# USER_EMAIL at an existing test-users.csv account would have contested {{TEST_USER_PASSWORD}} vs
# {{USER_PASSWORD}} and silently disabled password reconciliation for it.
USER_EMAIL=agent-test-shopper-vcpt@test-agent.com
USER2_EMAIL=kutasina.elena+user22@gmail.com

ADMIN_VIRTO=
ORG_USER_VIRTO=
PERSONAL_USER_VIRTO=

MULTI_ORG_USER_EMAIL=agent-test-multiorg-vcpt@test-agent.com
EUR_USER_EMAIL=agent-test-eur-vcpt@test-agent.com
ORG_USER_EMAIL=agent-test-org-vcpt@test-agent.com
ORG_USER_ID=7000d793-e141-44a1-b2c5-bdcb7e81cc8f
# LOYALTY_VIP_USER_EMAIL is env-invariant → now in .env.defaults. IMPERSONATION_ADMIN_EMAIL
# kept empty here: vcptcore has no Manager account to back it (intentional per-env blank).
IMPERSONATION_ADMIN_EMAIL=
LOCKOUT_TEST_EMAIL=

VALID_COUPON_CODE=
OOS_SKU=
LOW_STOCK_SKU=
PACK_SIZE_SKU=
TIER_PRICED_SKU=
CONFIGURABLE_SKU=

# --- Integration identifiers (tokens/passwords in .env.local) ----------------
# JIRA_EMAIL is deliberately NOT set here (same as .env.vcst): it is the identity half of the
# Basic-auth pair whose secret half (JIRA_API_TOKEN) is per-developer in .env.local. A committed
# email pinned one teammate's account against every other teammate's token — Jira then answers
# 404 on tickets that exist. Each developer's .env.local supplies both halves together.

AZURE_SUBSCRIPTION_ID=973d0b8c-44bf-438d-a4b7-1c4162d3ccba
AZURE_RESOURCE_GROUP=vcptcore
APPINSIGHTS_RESOURCE_BACKEND=vcptcore-qa
APPINSIGHTS_RESOURCE_STOREFRONT=vcptcore-qa-storefront
# Data-plane Application IDs (properties.AppId), verified via az 2026-06-08.
# NOTE: distinct from the resource object id from Resource Graph — the
# api.applicationinsights.io query API needs properties.AppId specifically.
APPINSIGHTS_APP_ID_BACKEND=0ab21c6a-c538-4e49-8bf8-92459beb4e45
APPINSIGHTS_APP_ID_STOREFRONT=e015609e-0547-401e-91db-f38c47d8c343

# ENV_RISK — Risk class: dev | test | staging | production.
#   production blocks admin-write suites by default; QA envs use test.
#   REQUIRED: a seeder aborts on an undeclared value rather than assuming dev.
ENV_RISK=test
