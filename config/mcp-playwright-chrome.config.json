{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": false
    },
    "contextOptions": {
      "viewport": {
        "width": 1440,
        "height": 900
      },
      "locale": "en-US",
      "recordHar": {
        "path": "./test-results/chrome/har/session.har",
        "omitContent": true
      },
      "recordVideo": {
        "dir": "./test-results/chrome/video",
        "size": {
          "width": 1440,
          "height": 900
        }
      }
    }
  },
  "outputDir": "./test-results/chrome",
  "screenshot": "only-on-failure"
}
