{
  "browser": {
    "browserName": "firefox",
    "isolated": true,
    "launchOptions": {
      "headless": false,
      "firefoxUserPrefs": {
        "widget.windows.window_occlusion_tracking.enabled": false
      }
    },
    "contextOptions": {
      "viewport": {
        "width": 1920,
        "height": 1080
      },
      "locale": "en-US",
      "recordHar": {
        "path": "./test-results/firefox/har/session.har",
        "omitContent": true
      }
    }
  },
  "outputDir": "./test-results/firefox",
  "screenshot": "only-on-failure",
  "timeouts": {
    "action": 30000,
    "navigation": 60000,
    "expect": 10000
  }
}
