{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": false,
      "channel": "msedge"
    },
    "contextOptions": {
      "viewport": {
        "width": 1920,
        "height": 1080
      },
      "locale": "en-US",
      "recordHar": {
        "path": "./test-results/edge/har/session.har",
        "content": "embed"
      },
      "deviceScaleFactor": 2
    }
  },
  "outputDir": "./test-results/edge",
  "screenshot": "only-on-failure"
}
