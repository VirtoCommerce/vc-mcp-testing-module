# ==============================================================================
# .env.local — customer secrets (GITIGNORED, never commit)
# ==============================================================================
#
# This template is what `npm run plugin:install` writes to .env.local for you.
# Edit by hand if you need to add more env profiles or change individual values.
#
# config.js (the layered env loader) reads, in order:
#   1. .env.defaults          — plugin-supplied constants (sandbox cards, etc.)
#   2. .env.${TEST_ENV}       — customer-required per-env values (URLs, IDs)
#   3. .env.local             — THIS FILE: secrets with per-env suffix promotion
#
# Per-env suffix promotion: when TEST_ENV=qa, the loader auto-promotes any var
# ending in `_QA` to its base name. So `USER_PASSWORD_QA=…` becomes
# `USER_PASSWORD` at runtime. This lets you keep ALL env credentials in ONE
# gitignored file without duplicating effort or risking commits of secrets.
#
# Rules:
#   - Env suffix must match [A-Z0-9_]+ (uppercase of your TEST_ENV).
#   - TEST_ENV must match [a-z0-9_]+ — kebab-case is rejected.
# ==============================================================================

# --- Storefront test user (per-env) ------------------------------------------
# Non-admin user. Used by checkout, cart, account, B2B-org tests.
USER_EMAIL_QA=qa-user@example.com
USER_PASSWORD_QA=replace-me
USER_EMAIL_STAGING=staging-user@example.com
USER_PASSWORD_STAGING=replace-me
USER_EMAIL_PROD=prod-readonly-user@example.com
USER_PASSWORD_PROD=replace-me

# --- Secondary storefront user (for B2B org tests, list sharing, etc.) -------
USER2_EMAIL_QA=qa-user2@example.com
USER2_PASSWORD_QA=replace-me
USER2_EMAIL_STAGING=
USER2_PASSWORD_STAGING=

# --- Admin SPA user (per-env) ------------------------------------------------
# Has back-office access. Some Backend suites require admin-write permissions —
# tag those suites with envRiskGate: "staging" if you don't want them on prod.
ADMIN_QA=qa-admin@example.com
ADMIN_PASSWORD_QA=replace-me
ADMIN_STAGING=staging-admin@example.com
ADMIN_PASSWORD_STAGING=replace-me
ADMIN_PROD=prod-readonly-admin@example.com
ADMIN_PASSWORD_PROD=replace-me

# --- Multi-org user (B2B suites only) ----------------------------------------
# A user that belongs to 2+ orgs — required by suite 006-b2b-organization for
# org-switch tests. Leave empty if you don't run B2B suites.
MULTI_ORG_USER_EMAIL_QA=
MULTI_ORG_USER_PASSWORD_QA=

# --- Shared test-account passwords (seeding — VCST-5406) ----------------------
# Only needed if you SEED test data (`npm run seed:company-users` / `seed:bootstrap`).
# The committed test-data CSVs reference these by {{VAR}} token instead of embedding
# secrets — user-provision.mjs resolves them at seed time. Safe non-prod defaults are
# shown so a fresh localhost seed works out of the box; override per env with the
# _${TEST_ENV^^} suffix (e.g. B2B_USER_PASSWORD_QA=…) like the users above.
B2B_USER_PASSWORD=TestPass123!            # every b2b/users.csv org member
TEST_USER_PASSWORD=Test123!               # test-users.csv generic QA users
DEFAULT_TEST_PASSWORD=Password1!          # imp targets + cross-org members
AGENT_SLOT1_PASSWORD=TestChromeAgent1!    # parallel-agent browser slots (agent-user-pool.csv)
AGENT_SLOT2_PASSWORD=TestFireFoxAgent2!
AGENT_SLOT3_PASSWORD=TestEdgeAgent3!
AGENT_PERSONAL_PASSWORD=Password2!

# Named per-role storefront accounts (identity/emails live in .env.<env>; secrets here).
# Backed by user-roles.mjs; used by the matching suites when present.
ORG_USER_PASSWORD=TestPass123!            # single-org B2B member (ORG_USER_EMAIL)
EUR_USER_PASSWORD=TestPass123!            # EUR-currency shopper (EUR_USER_EMAIL)
LOCKOUT_TEST_PASSWORD=TestLockout1!       # account-lockout suite (LOCKOUT_TEST_EMAIL)
IMPERSONATION_ADMIN_PASSWORD=TestImp1!    # login-on-behalf OPERATOR (suite 082 / b2b USR-024,
                                          # org-maintainer @ TechFlow incl. loginOnBehalf)

# Loyalty test-account secrets (emails/identity live in the per-env .env.<env> file).
# Only needed for loyalty suites (VCST-5101/5103/5135).
LOYALTY_VIP_USER_PASSWORD=TestVip1!
LOYALTY_NOBAL_USER_PASSWORD=TestNoBal1!
LOYALTY_WHOLESALE_USER_PASSWORD=TestWhsl1!

# Restricted back-office (Manager) RBAC account for CMS RBAC suites (CMS-123/124 in 059).
# Read-only Page Builder role (no builder:update). Email is a fixed AGENT-TEST business key
# (see backoffice-rbac-specs.mjs); only the secret lives here. Seed: `npm run seed:rbac`.
RESTRICTED_CMS_ADMIN_PASSWORD=Password1!

# --- Browser login secrets (Playwright MCP `--secrets`) — USE THE SCOPED FILE --
# For suites that log into the storefront/Admin SPA, the Playwright MCP servers
# substitute a password when `browser_type` is called with the secret's NAME (so the
# value never enters the agent transcript). Point `--secrets` at a DEDICATED, minimal
# file — NEVER at THIS file: .env.local also holds API tokens / keys (ANTHROPIC_API_KEY,
# GITHUB_TOKEN, JIRA_API_TOKEN, FIGMA/POSTMAN keys …) that must never be typeable into a
# web form. See templates/.env.playwright.local.template → copy to .env.playwright.local
# (auto-gitignored via .env.*.local) with ONLY the login passwords, and wire it in
# .mcp.json (see .mcp.json.example / .claude/rules/mcp-browsers.md).

# --- API + Integration secrets (cross-env, usually one set per customer) -----
# These don't typically vary per env (one API key per provider account).
FIGMA_API_KEY=
POSTMAN_API_KEY=
BUILDER_IO_EMAIL=
BUILDER_IO_PASSWORD=

# --- Atlassian / JIRA (for /qa-bug filing, /qa-status, /qa-test-plan) --------
# Typically configured at MCP level, not env vars. See docs/onboarding.md
# § Atlassian MCP setup.
# JIRA_PROJECT_KEY itself is per-env (lives in .env.${TEST_ENV}).

# --- BrowserStack (optional — only if you run cross-browser cloud tests) -----
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
