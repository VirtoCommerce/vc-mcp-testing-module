{
  "//": "TEMPLATE — copy to .mcp.json (gitignored) and replace every <PLACEHOLDER>. Restart the MCP servers after editing. Windows uses `cmd /c npx`; on Linux/macOS drop the `cmd` + `/c` and call `npx` directly.",
  "//secrets": "The `--secrets .env.playwright.local` on each Playwright server lets a suite log in by typing the secret NAME (e.g. browser_type text=B2B_USER_PASSWORD) — the MCP substitutes the value + redacts it, so no password enters the agent transcript. Point it at the SCOPED file (templates/.env.playwright.local.template → .env.playwright.local, login passwords ONLY) — NEVER at .env.local, which also holds API tokens/keys. Drop the `--secrets` lines from the Playwright servers if you don't run browser-login suites. See .claude/knowledge/execution/browser-lanes.md.",
  "mcpServers": {
    "playwright-chrome": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.77",
        "--config",
        "config/mcp-playwright-chrome.config.json",
        "--secrets",
        ".env.playwright.local"
      ]
    },
    "playwright-firefox": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.77",
        "--config",
        "config/mcp-playwright-firefox.config.json",
        "--secrets",
        ".env.playwright.local"
      ]
    },
    "playwright-edge": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.77",
        "--config",
        "config/mcp-playwright-edge.config.json",
        "--secrets",
        ".env.playwright.local"
      ]
    },
    "//mobile": "Touch/mobile lane — 390x844 portrait, isMobile + hasTouch, deviceScaleFactor 3. Several test cases' Preconditions require a touch viewport; without this server entry config/mcp-playwright-mobile.config.json is never loaded and the lane silently does not exist — the tell is that test-results/mobile/ never appears.",
    "playwright-mobile": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "@playwright/mcp@0.0.77",
        "--config",
        "config/mcp-playwright-mobile.config.json",
        "--secrets",
        ".env.playwright.local"
      ]
    },
    "Chrome DevTools": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "chrome-devtools-mcp@1.6.0",
        "--redactNetworkHeaders",
        "--viewport",
        "1920x1080",
        "--userDataDir",
        "<ABSOLUTE-PATH>/.chrome-devtools-mcp/vc-qa-profile"
      ],
      "env": {}
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/minimal",
      "headers": {
        "Authorization": "Bearer <POSTMAN_API_KEY>"
      }
    },
    "github": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<GITHUB_PERSONAL_ACCESS_TOKEN>"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "env": {
        "CONTEXT7_API_KEY": "<CONTEXT7_API_KEY>"
      }
    },
    "azure-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@azure/mcp@3.0.0-beta.32",
        "server",
        "start"
      ]
    },
    "figma-remote-mcp": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "env": {
        "FIGMA_API_KEY": "<FIGMA_API_KEY>"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    }
  }
}
