# ==============================================================================
# .env.playwright.local — SCOPED browser-login secrets (GITIGNORED, never commit)
# ==============================================================================
#
# Purpose: the ONLY secrets the Playwright MCP browser servers are allowed to type.
# Copy this to `.env.playwright.local` (auto-gitignored by the `.env.*.local` rule),
# fill the values from your team secret store, and wire it into .mcp.json:
#
#   "playwright-chrome": { "args": [ ..., "--config", "config/mcp-playwright-chrome.config.json",
#                                    "--secrets", ".env.playwright.local" ] }
#   (same for playwright-firefox / playwright-edge — see .mcp.json.example)
#
# How --secrets works: when an agent calls `browser_type(text="B2B_USER_PASSWORD")`,
# the MCP substitutes the value below and REDACTS it in logs — the plaintext never
# enters the agent's context or the transcript. Substitution triggers ONLY when the
# typed text EXACTLY equals a NAME in this file.
#
# WHY A SEPARATE FILE (least privilege — do NOT point --secrets at .env.local):
#   .env.local also holds API tokens / keys (ANTHROPIC_API_KEY, GITHUB_TOKEN,
#   GITHUB_FIX_BUGS_TOKEN, JIRA_API_TOKEN, FIGMA_API_KEY, POSTMAN_API_KEY,
#   BROWSERSTACK_ACCESS_KEY). If those were in the --secrets file, a malicious page or
#   a prompt-injection could get the agent to type a PAT/API key into an arbitrary web
#   form. This file contains ONLY non-prod test-account LOGIN passwords, so the worst
#   case is a low-value test password — never a token.
#
# Rules:
#   - LOGIN passwords ONLY. No API keys, OAuth tokens, or PATs — ever.
#   - Non-prod test accounts only.
#   - NAMES must match the {{VAR}} tokens the suites/CSVs type (b2b/users.csv, etc.).
#   - NOT suffix-promoted (the MCP reads this file raw). Put the concrete per-env value
#     for whichever env you run browser suites against.
#   - Values must equal the same env's .env.local values for the corresponding vars.
# ==============================================================================

# --- Storefront + Admin SPA logins the browser suites sign in with ------------
USER_PASSWORD=replace-me                  # main storefront shopper (USER_EMAIL)
USER2_PASSWORD=replace-me                 # secondary shopper (USER2_EMAIL)
ADMIN_PASSWORD=replace-me                 # Admin SPA login (test-env admin — NOT prod)
ORG_USER_PASSWORD=replace-me              # single-org B2B member
MULTI_ORG_USER_PASSWORD=replace-me        # multi-org member (org switching)
EUR_USER_PASSWORD=replace-me              # EUR-currency shopper
LOCKOUT_TEST_PASSWORD=replace-me          # account-lockout suite

# --- Shared seeded-account passwords (org members / imp operator / loyalty) ----
B2B_USER_PASSWORD=replace-me              # every b2b/users.csv org member (SUPPORT_AGENT, Nora, …)
DEFAULT_TEST_PASSWORD=replace-me          # imp targets + cross-org members
IMPERSONATION_ADMIN_PASSWORD=replace-me   # login-on-behalf OPERATOR (suite 082, b2b USR-024)
LOYALTY_VIP_USER_PASSWORD=replace-me
LOYALTY_NOBAL_USER_PASSWORD=replace-me
LOYALTY_WHOLESALE_USER_PASSWORD=replace-me

# --- Parallel-agent browser-slot logins (agent-user-pool.csv) -----------------
AGENT_SLOT1_PASSWORD=replace-me
AGENT_SLOT2_PASSWORD=replace-me
AGENT_SLOT3_PASSWORD=replace-me
AGENT_PERSONAL_PASSWORD=replace-me
