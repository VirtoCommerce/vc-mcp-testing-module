# ==============================================================================
# vcptcore-qa1 environment — third QA environment (vcptcore-qa1.govirto.com)
# Activate: TEST_ENV=vcptcore1 npm run env:check
# Committed; URLs/identifiers only — secrets live in .env.local
#   (admin password promoted from ADMIN_PASSWORD_VCPTCORE1 in .env.local)
#
# Discovered 2026-06-23 via /connect/token + /api/stores/search:
#   store B2B-store · catalog B2B-mixed (fc596540864a41bf8ab78734ee7353a3)
#   en-US / USD · storefront https://vcptcore-qa1-storefront.govirto.com
# Mirrors .env.vcptcore (same B2B-store slug + B2B-mixed catalog).
# ==============================================================================

# --- Risk gate ---------------------------------------------------------------
# QA env — admin-write suites + seeders allowed (not production).
ENV_RISK=test

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-qa1-storefront.govirto.com
# No trailing slash — seed-test-data.js concatenates `${BACK_URL}${path}` without
# normalizing, so a trailing slash would yield `//connect/token` (404).
BACK_URL=https://vcptcore-qa1.govirto.com
STORYBOOK_URL=https://vcptcore-qa1-storybook.govirto.com/
STORYBOOK_DEV_URL=https://vcptcore-qa1-storybook.govirto.com/

# --- Store configuration -----------------------------------------------------
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcptcore-qa1-storefront.govirto.com
# B2B-store catalog (B2B-mixed) + main fulfillment center, from /api/stores/search
STORE_CATALOG_ID=fc596540864a41bf8ab78734ee7353a3
MAIN_FULFILLMENT_CENTER_ID=142ba5568ae4454aad553ece41b9c3b5

# --- User identifiers (passwords in .env.local) ------------------------------
ADMIN=admin
# Alias of ADMIN — many suite CSVs reference {{ADMIN_EMAIL}} as the OAuth
# username for /connect/token grant_type=password. Same value as ADMIN.
ADMIN_EMAIL=admin
# Admin SPA / platform backend URL — same host as BACK_URL (without trailing slash).
ADMIN_URL=https://vcptcore-qa1.govirto.com

# Storefront test users — provisioned 2026-06-23 (Contact + Customer security
# account, storeId=B2B-store). Passwords in .env.local (USER_PASSWORD_VCPTCORE1 /
# USER2_PASSWORD_VCPTCORE1). Login verified via /connect/token.
USER_EMAIL=agent-test-user-vcpt1@test-agent.com
USER2_EMAIL=agent-test-user2-vcpt1@test-agent.com

# --- Seeded fixtures (provisioned via npm run seed:* — see test-data/_seed-results-*) -
VALID_COUPON_CODE=VALID10
OOS_SKU=QA-OOS-001
LOW_STOCK_SKU=QA-LOW-001
PACK_SIZE_SKU=QA-PACK-001
TIER_PRICED_SKU=QA-TIER-001
CONFIGURABLE_SKU=

# --- Integration identifiers (tokens/passwords in .env.local) ----------------
JIRA_EMAIL=elena.mutykova@virtoworks.com
