# ==============================================================================
# vcst-qa environment — primary QA (default when TEST_ENV is unset)
# Activate: TEST_ENV=vcst npm run env:check  (or just `npm run env:check`)
# Committed; URLs/identifiers only — secrets live in .env.local
# ==============================================================================

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcst-qa-storefront.govirto.com
BACK_URL=https://vcst-qa.govirto.com
STORYBOOK_URL=https://vcst-qa-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcst-dev-storybook.govirto.com

# --- Store configuration -----------------------------------------------------
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcst-qa-storefront.govirto.com
# Real GUID of USER_EMAIL on this environment — session-hint userId arg
TEST_USER_ID=42765f34-51cf-4994-806b-e82e65fd5c14

# --- User identifiers (passwords in .env.local) ------------------------------
# Admin (Platform SPA)
ADMIN=admin
# Alias of ADMIN — many suite CSVs reference {{ADMIN_EMAIL}} as the OAuth
# username for /connect/token grant_type=password. Same value as ADMIN.
ADMIN_EMAIL=admin
# Admin SPA / platform backend URL — same host as BACK_URL.
# Many suites use {{ADMIN_URL}} as a [NAV] target; kept as a separate alias
# so admin-only navigation can be retargeted per-env without touching BACK_URL.
ADMIN_URL=https://vcst-qa.govirto.com


USER_EMAIL=mutykovaelena@gmail.com

USER2_EMAIL=carl2026-carol@mail.com

# Virto-specific accounts
ADMIN_VIRTO=agent-chrome
ORG_USER_VIRTO=ricreyacrouyi-3425@yopmail.com
PERSONAL_USER_VIRTO=milamuller2024@yahoo.com

# B2B / multi-org / EUR / impersonation users
MULTI_ORG_USER_EMAIL=ricreyacrouyi-3425@yopmail.com
EUR_USER_EMAIL=larch9900.mango@mail.com
ORG_USER_EMAIL=test-emily.johnson-20260310@test-agent.com
# ORG_USER is the b2b account USR-006 (TechFlow admin). Its runtime platform id is
# resolved via @td(TECHFLOW_ADMIN.platform_id) — auto-written to aliases.{env}.json by
# the b2b-user seed writeback — so it no longer needs a committed ORG_USER_ID literal.

# IMPERSONATION_ADMIN_EMAIL + LOYALTY_VIP/NOBAL/WHOLESALE_USER_EMAIL are env-invariant
# AGENT-* fixture accounts — moved to .env.defaults (passwords stay in .env.local).
# LOCKOUT_TEST is a DESTRUCTIVE fixture — suite 044 deliberately fails logins on it until the
# platform locks the account. It therefore needs a DEDICATED account, exactly as 044's own
# precondition states ("Dedicated lockout-test user exists (LOCKOUT_TEST_EMAIL) isolated from
# agent pool slot accounts"). It used to point at test-sarah.chen-20260310@test-agent.com =
# b2b/users.csv USR-002 = @td(ACME_BUYER) — a shared happy-path B2B buyer. Two consequences,
# both observed live on 2026-07-29: (1) every lockout run left ACME_BUYER locked out, BLOCKING
# 15 cases of 050m-graphql-sales-rep for the lockout window; (2) the two registries declared
# different passwords ({{B2B_USER_PASSWORD}} vs LOCKOUT_TEST_PASSWORD) so the account held
# whichever seeder created it first and @td(ACME_BUYER.password) could never authenticate.
# Enforced by `npm run td:validate:credentials` check [4]. Seeded by `npm run seed:users`
# (role registry, kind=customer); password from .env.local LOCKOUT_TEST_PASSWORD.
LOCKOUT_TEST_EMAIL=agent-test-lockout-20260729@test-agent.com

VALID_COUPON_CODE=QA
# Permanent OOS fixture — test-products.csv PROD-101, @td(PROD_OOS.sku)
OOS_SKU=QA-OOS-001
# Near-limit stock fixture (stock 5) — PROD-102, @td(PROD_LOW_STOCK.sku)
LOW_STOCK_SKU=QA-LOW-001
# MOQ / pack-size 6 fixture — PROD-103, @td(PROD_PACK_SIZE.sku)
PACK_SIZE_SKU=QA-PACK-001
# Tier-priced fixture (1+ / 10+ / 20+ qty breaks) — PROD-104, @td(PROD_TIER_PRICED.sku)
TIER_PRICED_SKU=QA-TIER-001
CONFIGURABLE_SKU=AGENT-TEST-CFG-013-20260518
# Suite 009 references: TEST_SKU (variation default), TEST_SKU_CONFIGURABLE
# (configurable default), TEST_SKU_VARIANTS (multi-attribute variations).
TEST_SKU=XKC-38084072
TEST_SKU_CONFIGURABLE=AGENT-TEST-CFG-013-20260518
TEST_SKU_VARIANTS=XKC-38084072

# --- Azure Application Insights — online bug monitoring (/qa-monitoring) -------
# vcst-qa = platform/backend, vcst-qa-storefront = storefront (workspace-based /
# LogAnalytics ingestion). Subscription/RG/resource-names are identifiers
# (committed here). AUTH is AAD-first — your Azure login covers it, NO API key
# needed; keys are an optional fallback in .env.local (see .env.example).
AZURE_SUBSCRIPTION_ID=973d0b8c-44bf-438d-a4b7-1c4162d3ccba
AZURE_RESOURCE_GROUP=vcst
APPINSIGHTS_RESOURCE_BACKEND=vcst-qa
APPINSIGHTS_RESOURCE_STOREFRONT=vcst-qa-storefront
# App IDs resolved via Azure Resource Graph 2026-06-05
# (Portal path: resource → Configure → API Access → "Application ID").
APPINSIGHTS_APP_ID_BACKEND=7d07a5e2-1346-45b8-8b3c-2117c72a3f7b
APPINSIGHTS_APP_ID_STOREFRONT=a03ca744-2a0d-4586-ba1c-21312b6a118a

# === /project-init placeholders (vcst) — fill in the values below ===
# ENV_RISK — Risk class: dev | test | staging | production.
#   production blocks admin-write suites by default; QA envs use test.
ENV_RISK=test

# JIRA_BASE_URL — Jira base URL.
#   e.g. https://acme.atlassian.net
JIRA_BASE_URL=https://virtocommerce.atlassian.net

# JIRA_PROJECT_KEY — Jira project key for bug filing.
#   e.g. VCST.
JIRA_PROJECT_KEY=VCST
