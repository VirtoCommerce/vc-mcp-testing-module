# ==============================================================================
# virto-start (staging) environment
# Activate: TEST_ENV=virtostart npm run env:check
# Committed; URLs/identifiers only — secrets live in .env.local
#
# STATUS: URLs known (migrated from legacy VIRTO_START_FRONT/BACK).
# Test data (users, GUIDs, SKUs) is TODO — fill in as you start using staging.
# ==============================================================================

# --- Application URLs --------------------------------------------------------
# When TEST_ENV=virtostart, scripts read FRONT_URL / BACK_URL from this file.
# Legacy VIRTO_START_FRONT / VIRTO_START_BACK names are still consumed by
# ci/run-regression.ts and the GitHub Actions workflows — those continue to
# work via process.env injection. Cleaning that up is a follow-up PR.
FRONT_URL=https://virtostart-demo-store.govirto.com
BACK_URL=https://virtostart-demo-admin.govirto.com
# TODO: confirm if staging has its own Storybook deployments
STORYBOOK_URL=https://virtostart-main-storybook.govirto.com/

# --- Store configuration -----------------------------------------------------
# TODO: confirm staging store slug
STORE_ID=B2B-store
STOREFRONT_DOMAIN=virtostart-demo-store.govirto.com
TEST_USER_ID=946accc6-5a2d-4ed6-be66-ca282d960eb5

# --- User identifiers (passwords in .env.local) ------------------------------
# Per-env passwords: if a password differs from .env.local's base value, add
# `<KEY>_VIRTOSTART` to .env.local — config.js promotes it to <KEY> when
# TEST_ENV=virtostart. See plan Phase 2.
ADMIN=virto-admin
# Alias of ADMIN — many suite CSVs reference {{ADMIN_EMAIL}} as the OAuth
# username for /connect/token grant_type=password. Same value as ADMIN.
ADMIN_EMAIL=virto-admin
# Admin SPA / platform backend URL — same host as BACK_URL.
# Many suites use {{ADMIN_URL}} as a [NAV] target; kept as a separate alias
# so admin-only navigation can be retargeted per-env without touching BACK_URL.
ADMIN_URL=https://virtostart-demo-admin.govirto.com
USER_EMAIL=mutykovaelena@mail.com
USER2_EMAIL=deitrouvinike-8506@yopmail.com
# Password for USER_EMAIL on virtostart differs from vcst — set
# USER_PASSWORD_VIRTOSTART in .env.local

ADMIN_VIRTO=virto-admin
PERSONAL_USER_VIRTO=milamuller2024@yahoo.com

MULTI_ORG_USER_EMAIL=ricreyacrouyi-3425@yopmail.com
# EUR_USER must be its OWN account: sharing USER2_EMAIL made the EUR-vs-USD shopper
# distinction undecidable AND disabled password reconciliation for both roles.
# Mirrors .env.vcst. Seeded by `seed-company-users.mjs personal` (currencyCode=EUR).
EUR_USER_EMAIL=larch9900.mango@mail.com
# ORG_USER (single-org) must differ from MULTI_ORG_USER (org switching) or the two
# fixtures cannot discriminate. USR-006 in test-data/b2b/users.csv already declares
# {{ORG_USER_PASSWORD}}, so this is the one authoritative var. Mirrors .env.vcst.
ORG_USER_EMAIL=test-emily.johnson-20260310@test-agent.com
ORG_USER_ID=3a930db7-91f4-4ab7-8294-c22ddd5566ab
IMPERSONATION_ADMIN_EMAIL=
LOCKOUT_TEST_EMAIL=makjason@yopmail.com

VALID_COUPON_CODE=
OOS_SKU=
LOW_STOCK_SKU=
PACK_SIZE_SKU=
TIER_PRICED_SKU=
CONFIGURABLE_SKU=

# ENV_RISK — Risk class: dev | test | staging | production.
#   virto-start is a customer-facing DEMO/staging env, not a scratch QA box:
#   seed here deliberately, and dry-run first.
#   REQUIRED: a seeder aborts on an undeclared value rather than assuming dev.
ENV_RISK=staging

# --- Sales Rep demo dataset --------------------------------------------------
# Accounts the sales-rep inventory/teardown must NEVER delete. These are real
# people, not fixtures: sr:inventory classifies them `protected`, which also
# excludes their ORDERS from the sweep (orders are enumerated by rep userId).
#   alla.volkova  — a sales rep here since 2022-09-23; the demo REUSES her account.
#   maria.volkova — a colleague on the virtoworks.com domain, actively placing
#                   orders (two on 2026-09-21). Not part of the demo; left alone.
# Identities, not secrets, so they belong in this committed file.
SR_DEMO_PROTECTED_EMAILS=alla.volkova@virtoway.com,maria.volkova@virtoworks.com

# The two demo reps. Alla already exists as a sales rep, so the demo only adds
# served organizations to her. Oleg Zhuk does NOT exist on virtostart in any
# form, so the seeder must attach him — fill this in before seeding. The seeder
# throws rather than guessing: attaching rep status to the wrong real person is
# not a recoverable mistake.
SR_DEMO_REP_VOLKOVA_EMAIL=alla.volkova@virtoway.com
SR_DEMO_REP_ZHUK_EMAIL=oleg@virtoworks.com
