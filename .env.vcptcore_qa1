# ==============================================================================
# vcptcore-qa1 environment — twin of vcptcore, QA1 instance.
# Carries the deployed vc-module-x-cart PR #122 artifact (configurationSection
# field on cart line items — VCST-5173). Verified live 2026-06-24:
#   GraphQL endpoint is {BACK_URL}/graphql (NOT /xapi/graphql).
#   CartConfigurationItemType.configurationSection present in deployed schema.
# Activate: TEST_ENV=vcptcore_qa1 npm run env:check
# Committed; URLs/identifiers only — secrets live in .env.local.
#
# Per-env secret overrides (optional): add *_VCPTCORE_QA1 vars to .env.local;
# config.js promotes them over the generic ADMIN_PASSWORD/ORG_USER_PASSWORD/etc.
# ==============================================================================

# --- Risk gate ---------------------------------------------------------------
# QA env — admin-write suites + seeders allowed (not production).
ENV_RISK=test

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-qa1-storefront.govirto.com
BACK_URL=https://vcptcore-qa1.govirto.com
STORYBOOK_URL=https://vcptcore-qa1-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcptcore-qa1-storybook.govirto.com

# --- Store configuration -----------------------------------------------------
# B2B-store is the standard slug on vcst + vcptcore; confirm via env:check.
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcptcore-qa1-storefront.govirto.com
# B2B-store catalog (B2B-mixed) + main fulfillment center (Chicago), from /api/stores.
# NOTE: seeded inventory lives on the Bristol FC (e5aea833…); it was added to the
# store's additionalFulfillmentCenterIds so seeded stock is buyable on the storefront.
STORE_CATALOG_ID=fc596540864a41bf8ab78734ee7353a3
MAIN_FULFILLMENT_CENTER_ID=142ba5568ae4454aad553ece41b9c3b5
# TODO: real GUID of USER_EMAIL on qa1 (discover via `me { id }` after first auth)
TEST_USER_ID=

# --- User identifiers (passwords in .env.local) ------------------------------
# Test personas provisioned 2026-07-01 to mirror vcst (Contact + Customer security
# account, storeId=B2B-store). Login verified via /connect/token.
ADMIN=admin
ADMIN_EMAIL=admin
ADMIN_URL=https://vcptcore-qa1.govirto.com
# personal buyer + org maintainer (member of BMW-Group + Elena-Company)
USER_EMAIL=agent-test-user-vcpt1@test-agent.com
# second personal buyer (list-sharing / multi-user)
USER2_EMAIL=agent-test-user2-vcpt1@test-agent.com
# multi-org maintainer, EUR currency, member of 11 orgs
MULTI_ORG_USER_EMAIL=AGENT-TEST-imp-target-many-orgs-20260514@test-agent.com
# EUR-currency maintainer, single org (Elena-Company)
EUR_USER_EMAIL=agent-test-eur-vcpt@test-agent.com
# single-org member (AGENT-TEST-Org-TechFlow)
ORG_USER_EMAIL=agent-test-org-vcpt@test-agent.com
ORG_USER_ID=
# NOTE: loyalty module is NOT installed on qa1 — this account exists but
# loyalty-points earning is not reproducible on this environment.
LOYALTY_VIP_USER_EMAIL=AGENT-TEST-vip@test.virtocommerce.com
# admin-side Manager for impersonation (does not sign in to the storefront by design)
IMPERSONATION_ADMIN_EMAIL=agent-test-impersonator@virtoworks.com

# --- Seed fixtures (provisioned via npm run seed:* — see test-data/_seed-results-*) -
VALID_COUPON_CODE=VALID10
OOS_SKU=QA-OOS-001
LOW_STOCK_SKU=QA-LOW-001
PACK_SIZE_SKU=QA-PACK-001
TIER_PRICED_SKU=QA-TIER-001
CONFIGURABLE_SKU=

# --- Integration identifiers (tokens/passwords in .env.local) ----------------
JIRA_EMAIL=elena.mutykova@virtoworks.com
