# ==============================================================================
# vcptcore-qa1 environment — twin of vcptcore, QA1 instance.
# Carries the deployed vc-module-x-cart PR #122 artifact (configurationSection
# field on cart line items — VCST-5173). Verified live 2026-06-24:
#   GraphQL endpoint is {BACK_URL}/graphql (NOT /xapi/graphql).
#   CartConfigurationItemType.configurationSection present in deployed schema.
# Activate: TEST_ENV=vcptcore_qa1 npm run env:check
# Committed; URLs/identifiers only — secrets live in .env.local.
#
# Per-env secret overrides (optional): add *_VCPTCORE_QA1 vars to .env.local;
# config.js promotes them over the generic ADMIN_PASSWORD/ORG_USER_PASSWORD/etc.
# ==============================================================================

# --- Application URLs --------------------------------------------------------
FRONT_URL=https://vcptcore-qa1-storefront.govirto.com
BACK_URL=https://vcptcore-qa1.govirto.com
STORYBOOK_URL=https://vcptcore-qa1-storybook.govirto.com
STORYBOOK_DEV_URL=https://vcptcore-qa1-storybook.govirto.com

# --- Store configuration -----------------------------------------------------
# B2B-store is the standard slug on vcst + vcptcore; confirm via env:check.
STORE_ID=B2B-store
STOREFRONT_DOMAIN=vcptcore-qa1-storefront.govirto.com
# TODO: real GUID of USER_EMAIL on qa1 (discover via `me { id }` after first auth)
TEST_USER_ID=

# --- User identifiers (passwords in .env.local) ------------------------------
ADMIN=admin
ADMIN_EMAIL=admin
ADMIN_URL=https://vcptcore-qa1.govirto.com
# TODO: confirm storefront user accounts exist on qa1 (twin of vcptcore)
USER_EMAIL=mutykovaelena@gmail.com
USER2_EMAIL=kutasina.elena+user22@gmail.com
